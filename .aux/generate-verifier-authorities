#!/bin/sh

set -eu

# Generates the authorities a bootloader is built to accept, from the key
# directories that hold them. An authority keeps its identity and its
# certificates together, and a build needs those in DER form.
#
# An authority keeps certificates in the directory of the role they serve.
# Those under keys sign images themselves, those under issuers sign the
# certificates that then sign images. Either may hold several, which is how a
# key is replaced without retiring the authority.
#
# The output is replaced entirely, so an authority whose keys are gone does not
# stay behind.
#
#   $1  directory of authorities, one subdirectory each
#   $2  directory to generate them into

usage="usage: $(basename "$0") <key-directory> <output-directory>"
key_directory=${1:?$usage}
output_directory=${2:?$usage}

# Writes every certificate in directory $1 into $2 in DER form.
write_der_certificates() {
  for certificate in "$1"/*.pem; do
    [ -f "$certificate" ] || continue

    certificate_name=$(basename "$certificate" .pem)
    mkdir -p "$2"
    openssl x509 -in "$certificate" -outform DER \
      -out "${2}/${certificate_name}.der"
  done
}

rm -rf "$output_directory"

for authority in "$key_directory"/*; do
  [ -d "$authority" ] || continue

  name=$(basename "$authority")
  mkdir -p "${output_directory}/${name}"
  cp "${authority}/identity" "${output_directory}/${name}/"

  write_der_certificates "${authority}/keys" \
    "${output_directory}/${name}/keys"
  write_der_certificates "${authority}/issuers" \
    "${output_directory}/${name}/issuers"
done
