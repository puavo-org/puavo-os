#!/bin/sh

# Generate a new MOK if it does not exit already (https://wiki.debian.org/SecureBoot)
set -e
mkdir -p /etc/puavo-conf
cd /etc/puavo-conf

if [ -e mok.pem ]; then
    exit 0
fi

# Todo: Can we use RSA 4096?
openssl req -nodes -new -x509 -newkey rsa:2048 -keyout mok.priv -outform DER -out mok.der -days 3650 -subj "/CN=Puavo/"
openssl x509 -inform der -in mok.der -out mok.pem