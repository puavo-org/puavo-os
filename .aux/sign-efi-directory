#!/bin/sh
set -eu

panic() {
  echo "error: $1" >&2
  exit 1
}

usage() {
  echo "Usage: $0 <input-directory> <key-directory> <output-directory>"
  echo ""
  echo "Signs all EFI files in a specified directory with Secure Boot keys."
  exit 1
}

if [ "$#" -ne 3 ]; then
  usage
fi

input_directory=$1
key_directory=$2
output_directory=$3

[ -d "$input_directory" ]  || panic "input directory '$input_directory' does not exist"
[ -d "$key_directory" ]    || panic "key directory '$key_directory' does not exist"
[ -d "$output_directory" ] || panic "output directory '$output_directory' does not exist"

# Sign all EFI files in the directory
signed_any=false
for efi_file in "$input_directory"/*.efi; do
  [ -f "$efi_file" ] || continue

  output_file="${output_directory}/$(basename "$efi_file").signed"
  "$(dirname "$0")/sign-efi-file" "$efi_file" "$key_directory" "$output_file"

  signed_any=true
done

if [ "$signed_any" = false ]; then
  panic "no EFI files found in '$input_directory'"
fi
