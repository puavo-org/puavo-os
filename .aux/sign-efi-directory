#!/bin/sh
set -eu

panic() {
  echo "error: $1" >&2
  exit 1
}

usage() {
  echo "Usage: $0 <directory> <key-file> <certificate-file> <output-directory>"
  echo ""
  echo "Signs all EFI files in a specified directory with Secure Boot keys."
  exit 1
}

if [ "$#" -ne 4 ]; then
  usage
fi

input_directory=$1
private_key=$2
certificate=$3
output_directory=$4

. "$(dirname "$0")/signing-backend"
engine_arguments=$(signing_sbsign_engine_arguments)

[ -d "$input_directory" ]  || panic "input directory '$input_directory' does not exist"
[ -d "$output_directory" ] || panic "output directory '$output_directory' does not exist"
[ -f "$certificate" ]      || panic "certificate not found at '$certificate'"
signing_require_private_key "$private_key" || exit 1

if ! command -v sbsign >/dev/null 2>&1; then
  panic "sbsign command not found"
fi

# Sign all EFI files in the directory
signed_any=false
for efi_file in "$input_directory"/*.efi; do
  [ -f "$efi_file" ] || continue

  efi_basename=$(basename "$efi_file")
  output_file="${output_directory}/${efi_basename}.signed"
  temporary_output="${output_file}.tmp"

  echo "signing ${efi_basename}..."
  sbsign $engine_arguments \
        --key "$private_key" \
        --cert "$certificate" \
        --output "$temporary_output" \
        "$efi_file"

  mv "$temporary_output" "$output_file"
  signed_any=true
done

if [ "$signed_any" = false ]; then
  panic "no EFI files found in '$input_directory'"
fi
