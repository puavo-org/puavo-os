#!/bin/sh

set -eu

proxy_address=$1
machine=$2
user=$3
shift 3

mount -m -t sysfs    /sys     /sys
mount -m -t proc     /proc    /proc
mount -m -t devpts   /dev/pts /dev/pts
hostname "$machine"
sudo -u "$user" env -u LANGUAGE \
    LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    PUAVO_CACHE_PROXY="$proxy_address" "$@"
