#!/bin/sh
set -eu

panic() {
  echo "error: $1" >&2
  exit 1
}

usage() {
  echo "Usage: $0 <architecture> <output>"
  exit 1
}

if [ $# -ne 2 ]; then
  usage
fi

architecture="$1"
output="$2"

build_directory=$(mktemp -d)
cleanup() {
  rm -rf "${build_directory}"
}
trap cleanup EXIT INT TERM

# The linux module is left out on purpose.
#
# This GRUB is configured for UKI installations.
# It must only chainload, because a chainloaded image is loaded through
# the firmware, which verifies its Secure Boot signature. Because slab
# installs the shim lock protocol, GRUB's linux command would instead
# take its legacy path and boot the kernel directly, without the
# firmware, trusting the shim lock verifier for the signature. Slab's
# verifier only enforces the revocation floor, not signatures, so a
# linux command here would run unsigned kernels under GRUB's key.
#
# Legacy installs use a separate GRUB bootloader.
modules="
  all_video
  boot
  btrfs
  cat
  chain
  configfile
  echo
  fat
  font
  gettext
  gfxmenu
  gfxterm
  gzio
  halt
  jpeg
  keystatus
  loadenv
  loopback
  ls
  lvm
  normal
  ntfs
  part_msdos
  part_gpt
  png
  probe
  regexp
  search
  search_fs_uuid
  search_fs_file
  search_label
  sleep
  smbios
  squash4
  test
  true
  video
  "

sbat_file="${build_directory}/sbat"
cat > "$sbat_file" <<EOF
sbat,1,SBAT Version,sbat,1,https://github.com/rhboot/shim/blob/main/SBAT.md
grub,5,Free Software Foundation,grub,2.12,https://www.gnu.org/software/grub/
grub.puavo,1,Puavo,grub2,2.12,https://github.com/puavo-org/puavo-os
EOF

modules_directory="/usr/lib/grub/${architecture}/"

grub-mkstandalone \
  --directory "${modules_directory}" \
  --format "${architecture}" \
  --fonts="unicode" \
  --sbat="$sbat_file" \
  --modules="$modules" \
  --install-modules="$modules" \
  --output="$output"

"$(dirname "$0")/add-bootloader-version-section" "$output" grub 1
