#!/bin/sh
# Signing backend abstraction.
# Reads 'config/signing.conf' and allows environment variable overrides.
#
# In file mode, private keys are PEM files in the key directory.
# In PKCS#11 mode, the key directory contains:
#   secure-boot.uri              (Secure Boot private key URI)
#   secure-boot-*.uri            (Additional Secure Boot private key URIs)
#   secure-boot.pem              (Primary Secure Boot certificate)
#   secure-boot-*.pem            (Additional Secure Boot certificates)
#   tpm2-pcr-private-key.uri     (Primary PCR private key URI)
#   tpm2-pcr-private-key-*.uri   (Additional PCR private key URIs)
#   tpm2-pcr-certificate.pem     (Primary PCR certificate (X.509))
#   tpm2-pcr-certificate-*.pem   (Additional PCR certificates)

_signing_config="$(dirname "$0")/../config/signing.conf"
if [ -f "$_signing_config" ]; then
  . "$_signing_config"
fi

SIGNING_BACKEND="${SIGNING_BACKEND:-file}"
SIGNING_ENGINE="${SIGNING_ENGINE:-pkcs11}"
SIGNING_PROVIDER="${SIGNING_PROVIDER:-}"

signing_is_pkcs11() {
  [ "$SIGNING_BACKEND" = "pkcs11" ]
}

# Read a PKCS#11 URI from a .uri file.
signing_read_uri() {
  if [ ! -f "$1" ]; then
    echo "error: PKCS#11 URI file not found at '$1'" >&2
    return 1
  fi
  cat "$1"
}

signing_validate() {
  if signing_is_pkcs11 && [ -z "$SIGNING_ENGINE" ] && [ -z "$SIGNING_PROVIDER" ]; then
    echo "error: SIGNING_ENGINE or SIGNING_PROVIDER must be set for PKCS#11" >&2
    return 1
  fi
}

signing_require_private_key() {
  if ! signing_is_pkcs11 && [ ! -f "$1" ]; then
    echo "error: private key not found at '$1'" >&2
    return 1
  fi
}

signing_secureboot_private_key() {
  if signing_is_pkcs11; then
    signing_read_uri "${1}/secure-boot.uri"
  else
    printf '%s' "${1}/secure-boot.priv"
  fi
}

signing_secureboot_certificate() {
  printf '%s' "${1}/secure-boot.pem"
}

# List additional Secure Boot key pairs.
# Each line of output is: <private_key> <certificate>
signing_secureboot_additional_keys() {
  _key_directory="$1"

  if signing_is_pkcs11; then
    for _certificate in "${_key_directory}"/secure-boot-*.pem; do
      [ -f "$_certificate" ] || continue
      _uri_file=$(echo "$_certificate" | sed 's/\.pem$/.uri/')
      _private_key=$(signing_read_uri "$_uri_file") || continue
      echo "${_private_key} ${_certificate}"
    done
  else
    for _certificate in "${_key_directory}"/secure-boot-*.pem; do
      [ -f "$_certificate" ] || continue
      _private_key=$(echo "$_certificate" | sed 's/\.pem$/.priv/')
      [ -f "$_private_key" ] || continue
      echo "${_private_key} ${_certificate}"
    done
  fi
}

# Check whether additional Secure Boot key pairs exist.
signing_secureboot_has_additional_keys() {
  _key_directory="$1"
  _additional=$(signing_secureboot_additional_keys "$_key_directory")
  [ -n "$_additional" ]
}

# Add an additional Secure Boot signature to an already-signed EFI binary.
signing_secureboot_attach_signature() {
  _efi_file="$1"
  _private_key="$2"
  _certificate="$3"

  _engine_arguments=$(signing_sbsign_engine_arguments)

  sbsign $_engine_arguments \
    --key "$_private_key" \
    --cert "$_certificate" \
    --output "$_efi_file" \
    "$_efi_file"
}

# Sign an EFI binary with all additional Secure Boot keys.
signing_secureboot_sign_additional() {
  _efi_file="$1"
  _key_directory="$2"

  signing_secureboot_additional_keys "$_key_directory" | while IFS=' ' read -r _private_key _certificate; do
    [ -n "$_private_key" ] || continue
    echo "  attaching additional signature: $(basename "$_certificate")"
    signing_secureboot_attach_signature "$_efi_file" "$_private_key" "$_certificate"
  done
}

# Resolve a PCR private key reference.
# In file mode the argument is returned as-is.
# In PKCS#11 mode the corresponding .uri file is read instead.
signing_pcr_private_key() {
  if signing_is_pkcs11; then
    signing_read_uri "$(echo "$1" | sed 's/\.pem$/.uri/')"
  else
    printf '%s' "$1"
  fi
}

signing_ukify_engine_arguments() {
  if signing_is_pkcs11; then
    if [ -n "$SIGNING_PROVIDER" ]; then
      printf '%s' "--signing-provider=${SIGNING_PROVIDER}"
    elif [ -n "$SIGNING_ENGINE" ]; then
      printf '%s' "--signing-engine=${SIGNING_ENGINE}"
    fi
  fi
}

signing_sbsign_engine_arguments() {
  if signing_is_pkcs11; then
    printf '%s' "--engine ${SIGNING_ENGINE}"
  fi
}
