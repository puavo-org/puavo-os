#!/bin/sh
set -e

usage() {
  echo "Usage: $0 <boot-folder> <key-folder> <image-file> <uki-prefix>"
  exit 1
}

if [ "$#" -ne 4 ]; then
  usage
fi

boot_folder=$1
key_folder=$2
image_file=$3
uki_prefix=$4

for kernel_image in "$boot_folder"/vmlinuz-*; do
  kernel_version=$(basename "$kernel_image" | sed 's/vmlinuz-//')
  output_path="${boot_folder}/${uki_prefix}-${kernel_version}.uki.efi"
  .aux/create-uki "$boot_folder" "$key_folder" "$kernel_version" "$output_path"
done

addon_folder="$boot_folder/addons"
mkdir -p "$addon_folder"

.aux/create-cmdline-addon "ro splash loglevel=3 rd.auto=1 init=/sbin/init-puavo puavo.hosttype=diskinstaller puavo.image.path=/installimages/${image_file}" "${addon_folder}/diskinstaller.addon.efi"
.aux/create-cmdline-addon "ro splash loglevel=3 rd.auto=1 init=/sbin/init-puavo puavo.hosttype=preinstalled puavo.image.path=/images/${image_file}" "${addon_folder}/preinstalled.addon.efi"
.aux/create-cmdline-addon "ro splash loglevel=3 rd.auto=1 init=/sbin/init-puavo puavo.hosttype=laptop puavo.image.path=/images/${image_file}" "${addon_folder}/laptop.addon.efi"
