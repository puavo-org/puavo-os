#!/bin/sh
set -e

boot_folder=$1
output_name=$2

if [ -z "$boot_folder" ] || [ -z "output_name" ]; then
  echo "Usage: $0 <boot-folder> <output-name>"
  exit 1
fi

.aux/create-uki "$boot_folder" "${boot_folder}/${output_name}"

addon_folder="$boot_folder/addons"
mkdir -p "$addon_folder"

.aux/create-cmdline-addon "ro splash loglevel=3 rd.auto=1 init=/sbin/init-puavo puavo.hosttype=diskinstaller puavo.image.path=/images/ltsp.img" "$addon_folder/diskinstaller.addon.efi"
.aux/create-cmdline-addon "ro splash loglevel=3 rd.auto=1 init=/sbin/init-puavo puavo.hosttype=preinstalled puavo.image.path=/images/ltsp.img" "$addon_folder/preinstalled.addon.efi"
