#!/bin/sh

# Append verity data to an image file as follows:
#
#   +--------------------+ 0
#   | filesystem         |
#   +--------------------+ data_size
#   | verity hash tree   |
#   +--------------------+ end - footer_size
#   | footer             |
#   +--------------------+ end
#
# The footer is JSON padded to a fixed size.
#
# The kernel accepts the signature only if the signing key is in a
# keyring it trusts.

set -eu

BLOCK_SIZE=4096
FOOTER_SIZE=4096
FOOTER_VERSION=1

panic() {
  echo "error: $*" >&2
  exit 1
}

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 <image-file> <signing-key>" >&2
  exit 2
fi

image_file=$1
signing_key=$2

[ -f "$image_file" ]  || panic "no such image file: ${image_file}"
[ -f "$signing_key" ] || panic "no such signing key: ${signing_key}"

work_directory=$(mktemp -d)
trap 'rm -rf "$work_directory"' EXIT

root_hash_file="${work_directory}/root-hash"
signature_file="${work_directory}/signature"
footer_file="${work_directory}/footer"

# The hash tree must start on a block boundary.
data_size=$(stat -c %s "$image_file")
padding=$(( (BLOCK_SIZE - data_size % BLOCK_SIZE) % BLOCK_SIZE ))

if [ "$padding" -gt 0 ]; then
  head -c "$padding" /dev/zero >> "$image_file"
  data_size=$(( data_size + padding ))
fi

veritysetup format "$image_file" "$image_file" \
  --data-block-size="$BLOCK_SIZE"              \
  --hash-block-size="$BLOCK_SIZE"              \
  --data-blocks=$(( data_size / BLOCK_SIZE ))  \
  --hash-offset="$data_size"                   \
  --root-hash-file="$root_hash_file"           \
  || panic 'failed to build the verity hash tree'

openssl cms -sign -nocerts -noattr -binary -outform der \
  -in "$root_hash_file"                                 \
  -inkey "$signing_key"                                 \
  -signer "$signing_key"                                \
  -out "$signature_file"                                \
  || panic 'failed to sign the root hash'

# Confirm the signature, -noverify skips trust.
openssl cms -verify -inform der -binary -nointern -noverify \
  -in "$signature_file"                                     \
  -content "$root_hash_file"                                \
  -certfile "$signing_key"                                  \
  -out /dev/null                                            \
  || panic 'the root hash signature does not verify'

jq --null-input --compact-output                           \
  --argjson version "$FOOTER_VERSION"                      \
  --argjson data_size "$data_size"                         \
  --arg root_hash "$(cat "$root_hash_file")"               \
  --arg signature "$(base64 --wrap=0 < "$signature_file")" \
  '{$version, $data_size, $root_hash, $signature}'         \
  > "$footer_file"

footer_size=$(stat -c %s "$footer_file")
[ "$footer_size" -le "$FOOTER_SIZE" ] || panic 'the footer does not fit'

# Pad with line breaks to make the footer fixed size.
yes '' | head -c $(( FOOTER_SIZE - footer_size )) >> "$footer_file"

cat "$footer_file" >> "$image_file"

echo "verity root hash: $(cat "$root_hash_file")"
