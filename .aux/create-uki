#!/bin/sh
set -e

usage() {
  echo "Usage: $0 <boot-directory> <art-directory> <key-directory> <kernel-version> <output>"
  exit 1
}

if [ "$#" -ne 5 ]; then
  usage
fi

boot_directory=$1
art_directory=$2
key_directory=$3
kernel_version=$4
output=$5

kernel_image="${boot_directory}/vmlinuz-${kernel_version}"
initrd_image="${boot_directory}/initrd.img-${kernel_version}"
os_release=$(basename "$output")

# Sign the PCR values with additional keys as well.
# Primary PCR key pair: tpm2-pcr-private-key.pem and tpm2-pcr-public-key.pem
# Additional PCR key pairs:
# tpm2-pcr-private-key-<name>.pem and tpm2-pcr-public-key-<name>.pem
pcr_key_arguments=""
for private_key in "${key_directory}"/tpm2-pcr-private-key*.pem; do
  [ -f "$private_key" ] || continue
  public_key=$(echo "$private_key" |
               sed 's/tpm2-pcr-private-key/tpm2-pcr-public-key/')
  if [ -f "$public_key" ]; then
    pcr_key_arguments="$pcr_key_arguments --pcr-private-key=${private_key} --pcr-public-key=${public_key}"
  else
    echo "error: corresponding public key not found for $private_key" >&2
    exit 2
  fi
done

# Find the bootsplash image
bootsplash_image="${art_directory}/bootsplash.bmp"

# NOTE: By default, halt on emergency instead of dropping to shell for security
ukify build \
  --linux="$kernel_image" \
  --initrd="$initrd_image" \
  --uname="${kernel_version}" \
  --os-release="$os_release" \
  --cmdline="rd.emergency=poweroff rd.shell=0" \
  $pcr_key_arguments \
  --pcrpkey="${key_directory}/tpm2-pcr-public-key.pem" \
  --pcr-banks=sha1,sha256 \
  --secureboot-private-key="${key_directory}/secure-boot.priv" \
  --secureboot-certificate="${key_directory}/secure-boot.pem" \
  --splash="${bootsplash_image}" \
  --output "$output" \
  --measure
