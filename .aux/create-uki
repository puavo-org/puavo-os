#!/bin/sh
set -e

usage() {
  echo "Usage: $0 <boot-directory> <art-directory> <key-directory> <kernel-version> <output>"
  exit 1
}

if [ "$#" -ne 5 ]; then
  usage
fi

boot_directory=$1
art_directory=$2
key_directory=$3
kernel_version=$4
output=$5

. "$(dirname "$0")/signing-backend"
signing_validate || exit 2

kernel_image="${boot_directory}/vmlinuz-${kernel_version}"
initrd_image="${boot_directory}/initrd.img-${kernel_version}"
os_release=$(basename "$output")

secure_boot_private_key=$(signing_secureboot_private_key "$key_directory")
secure_boot_certificate=$(signing_secureboot_certificate "$key_directory")
engine_arguments=$(signing_ukify_engine_arguments)

# Build PCR key arguments by iterating over certificate or public key files.
# Only certificates appear to work for PKCS#11 backend and public keys
# for the file based backend.
pcr_key_arguments=""

if signing_is_pkcs11; then
  for certificate in "${key_directory}"/tpm2-pcr-certificate*.pem; do
    [ -f "$certificate" ] || continue
    private_key_file=$(echo "$certificate" |
                        sed 's/tpm2-pcr-certificate/tpm2-pcr-private-key/')
    private_key=$(signing_pcr_private_key "$private_key_file")
    pcr_key_arguments="$pcr_key_arguments --pcr-private-key=${private_key} --pcr-public-key=${certificate}"
  done
else
  for public_key in "${key_directory}"/tpm2-pcr-public-key*.pem; do
    [ -f "$public_key" ] || continue
    private_key_file=$(echo "$public_key" |
                        sed 's/tpm2-pcr-public-key/tpm2-pcr-private-key/')
    private_key=$(signing_pcr_private_key "$private_key_file")
    pcr_key_arguments="$pcr_key_arguments --pcr-private-key=${private_key} --pcr-public-key=${public_key}"
  done
fi

bootsplash_image="${art_directory}/bootsplash.bmp"

# NOTE: By default, power off on emergency instead of dropping to shell for security
ukify build \
  --linux="$kernel_image" \
  --initrd="$initrd_image" \
  --uname="${kernel_version}" \
  --os-release="$os_release" \
  --cmdline="rd.emergency=poweroff rd.shell=0" \
  $pcr_key_arguments \
  --pcrpkey="${key_directory}/tpm2-pcr-public-key.pem" \
  --pcr-banks=sha1,sha256 \
  $engine_arguments \
  --secureboot-private-key="${secure_boot_private_key}" \
  --secureboot-certificate="${secure_boot_certificate}" \
  --splash="${bootsplash_image}" \
  --output "$output" \
  --measure
