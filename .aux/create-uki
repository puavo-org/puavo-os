#!/bin/sh

set -eu

tmpdir=''

cleanup() {
  if [ -n "$tmpdir" ]; then
    rm -rf "$tmpdir" || true
  fi
}
trap cleanup 0 INT TERM

check_bsdiff_file() {
  local initrd_image kernel_image tmp_ukibase_path tmp_uki_path uki_path \
        uki_patch_path

  kernel_image=$1
  initrd_image=$2
  uki_path=$3
  uki_patch_path=$4

  if [ ! -e "$uki_patch_path" ]; then
    return 1
  fi

  tmp_ukibase_path="${tmpdir}/check_uki_base"
  tmp_uki_path="${tmpdir}/check_uki_patched"

  cat "$kernel_image" "$initrd_image" > "$tmp_ukibase_path"
  if ! bspatch "$tmp_ukibase_path" "$tmp_uki_path" "$uki_patch_path"; then
    echo 'Error when checking patch: bspatch returned error' >&2
    rm -f "$tmp_ukibase_path" "$tmp_uki_path"
    return 1
  fi

  if ! cmp "$tmp_uki_path" "$uki_path" > /dev/null 2>&1; then
    echo 'The current UKI patch does not match the current UKI' >&2
    rm -f "$tmp_ukibase_path" "$tmp_uki_path"
    return 1
  fi

  return 0
}

create_bsdiff_file() {
  local initrd_image kernel_image tmp_uki_patch_path tmp_uki_patch_base_path \
        uki_patch_path uki_path

  kernel_image=$1
  initrd_image=$2
  uki_path=$3

  uki_patch_path="${uki_path}.bsdiff"
  tmp_uki_patch_path="${uki_patch_path}.tmp"

  # As UKI files are not deterministic, this is pointless, but I suppose
  # (in theory) some day they could be, and this would be a nice speedup.
  if check_bsdiff_file "$kernel_image" "$initrd_image" "$uki_path"\
                       "$uki_patch_path"; then
    echo "The current bsdiff file ${uki_patch_file} is up-to-date."
    return 0
  fi

  tmp_uki_patch_base_path="${tmpdir}/patching_uki_base"
  cat "$kernel_image" "$initrd_image" > "$tmp_uki_patch_base_path" || return 1
  echo -n "Creating bsdiff file from UKI ${uki_path}... "
  bsdiff "$tmp_uki_patch_base_path" "$uki_path" "$tmp_uki_patch_path" \
    || return 1
  mv "$tmp_uki_patch_path" "$uki_patch_path" || return 1
  echo DONE.

  # Check the resulting file to verify that patch generation produced
  # a good patch.
  if ! check_bsdiff_file "$kernel_image" "$initrd_image" "$uki_path"\
                         "$uki_patch_path"; then
    echo "The generated bsdiff file for ${uki_patch_file} is corrupt." >&2
    return 1
  fi

  return 0
}

usage() {
  echo "Usage: $0 <boot-directory> <art-directory> <key-directory> <kernel-version> <uki_path>"
  exit 1
}

if [ "$#" -ne 5 ]; then
  usage
fi

boot_directory=$1
art_directory=$2
key_directory=$3
kernel_version=$4
uki_file_path=$5

if ! tmpdir=$(mktemp -d "/tmp/create-uki.${uki_file_path##/*}.XXXXXX"); then
  echo 'Error in creating a temporary directory' >&2
  exit 1
fi

. "$(dirname "$0")/signing-backend"
signing_validate || exit 2

kernel_image="${boot_directory}/vmlinuz-${kernel_version}"
initrd_image="${boot_directory}/initrd.img-${kernel_version}"
os_release=$(basename "$uki_file_path")

secure_boot_private_key=$(signing_secureboot_private_key "$key_directory")
secure_boot_certificate=$(signing_secureboot_certificate "$key_directory")
engine_arguments=$(signing_ukify_engine_arguments)

# Build PCR key arguments by iterating over certificate or public key files.
# Only certificates appear to work for PKCS#11 backend and public keys
# for the file based backend.
pcr_key_arguments=""

if signing_is_pkcs11; then
  for certificate in "${key_directory}"/tpm2-pcr-certificate*.pem; do
    [ -f "$certificate" ] || continue
    private_key_file=$(echo "$certificate" |
                        sed 's/tpm2-pcr-certificate/tpm2-pcr-private-key/')
    private_key=$(signing_pcr_private_key "$private_key_file")
    pcr_key_arguments="$pcr_key_arguments --pcr-private-key=${private_key} --pcr-public-key=${certificate}"
  done
else
  for public_key in "${key_directory}"/tpm2-pcr-public-key*.pem; do
    [ -f "$public_key" ] || continue
    private_key_file=$(echo "$public_key" |
                        sed 's/tpm2-pcr-public-key/tpm2-pcr-private-key/')
    private_key=$(signing_pcr_private_key "$private_key_file")
    pcr_key_arguments="$pcr_key_arguments --pcr-private-key=${private_key} --pcr-public-key=${public_key}"
  done
fi

bootsplash_image="${art_directory}/bootsplash.bmp"

# Add version for revocation purposes.
version_section="${tmpdir}/version.section"
"$(dirname "$0")/add-bootloader-version-section" \
  --write-section "$version_section" puavo 1

# NOTE: By default, power off on emergency instead of dropping to shell
# NOTE: for security.
ukify build \
  --linux="$kernel_image" \
  --initrd="$initrd_image" \
  --uname="${kernel_version}" \
  --os-release="$os_release" \
  --cmdline="lockdown=confidentiality rd.emergency=poweroff rd.shell=0" \
  $pcr_key_arguments \
  --pcrpkey="${key_directory}/tpm2-pcr-public-key.pem" \
  --pcr-banks=sha1,sha256 \
  $engine_arguments \
  --secureboot-private-key="${secure_boot_private_key}" \
  --secureboot-certificate="${secure_boot_certificate}" \
  --splash="${bootsplash_image}" \
  --section ".version:@${version_section}" \
  --output "$uki_file_path" \
  --measure

# Attach additional Secure Boot signatures if additional key pairs exist
if signing_secureboot_has_additional_keys "$key_directory"; then
  echo 'Attaching additional Secure Boot signatures to UKI...'
  signing_secureboot_sign_additional "$uki_file_path" "$key_directory"
fi

(
  cd "$(dirname "$uki_file_path")"
  sha256sum "$(basename "$uki_file_path")" > "${uki_file_path}.sha256.tmp"
  mv "${uki_file_path}.sha256.tmp" "${uki_file_path}.sha256"
)

if ! create_bsdiff_file "$kernel_image" "$initrd_image" "$uki_file_path"; then
  echo "Could not create bsdiff file for UKI ${uki_file_path}" >&2
  exit 1
fi
