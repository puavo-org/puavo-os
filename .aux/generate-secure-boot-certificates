#!/bin/sh
set -eu

echo "generating Secure Boot certificates..."
guid='7cb44677-9bb9-4504-bb8f-923def5fa3b1'

# Generate the Secure Boot DB certificate
openssl req -new -x509 -newkey rsa:4096 -nodes -days 36500 \
  -subj "/CN=Puavo DB, O=Puavo/" \
  -keyout db.key -out db.crt

# Convert the DB certificate to an EFI signature list
cert-to-efi-sig-list -g "$guid" db.crt db.esl

echo "generated Secure Boot certificate successfully"
