#!/bin/sh
set -eu

panic() {
  echo "error: $1" >&2
  exit 1
}

usage() {
  echo "Usage: $0 <rootfs-directory> <key-directory>"
  echo ""
  echo "Signs GRUB and SHIM bootloaders with Secure Boot keys."
  exit 1
}

if [ "$#" -ne 2 ]; then
  usage
fi

rootfs_directory=$1
key_directory=$2

. "$(dirname "$0")/signing-backend"
signing_validate || exit 2

private_key=$(signing_secureboot_private_key "$key_directory")
certificate=$(signing_secureboot_certificate "$key_directory")

[ -d "$rootfs_directory" ] || panic "rootfs directory '$rootfs_directory' does not exist"
[ -d "$key_directory" ]    || panic "key directory '$key_directory' does not exist"
[ -f "$certificate" ]      || panic "certificate not found at '$certificate'"
signing_require_private_key "$private_key" || exit 1

if ! command -v grub-mkstandalone >/dev/null 2>&1; then
  panic "grub-mkstandalone not found"
fi

shared_build_directory=$(mktemp -d) || panic "failed to create shared build directory"
cleanup_all() {
  rm -rf -- "$shared_build_directory"
}
trap cleanup_all EXIT INT TERM

create_grub_architecture_bootloader() {
  architecture=$1

  # Per-architecture build directory under the shared build directory
  grub_build_directory="${shared_build_directory}/${architecture}"
  mkdir -p "$grub_build_directory"

  case "$architecture" in
    x86_64-efi) grub_output_name=grubx64.efi ;;
    i386-efi) grub_output_name=grubia32.efi ;;
    *) panic "unsupported architecture '$architecture'"
  esac
  grub_output="${grub_build_directory}/${grub_output_name}"

  echo "creating GRUB bootloader for ${architecture}..."
  .aux/create-grub-bootloader "$architecture" "$grub_output"

  # Create a directory for the signed bootloader
  grub_signed_directory="${rootfs_directory}/usr/lib/grub/${architecture}-signed"
  mkdir -p "$grub_signed_directory"

  echo "signing GRUB bootloader for ${architecture}..."
  .aux/sign-efi-directory "$grub_build_directory" "$private_key" "$certificate" "$grub_signed_directory"
}

for architecture in i386-efi x86_64-efi; do
  create_grub_architecture_bootloader "$architecture"
done

shim_source_directory="${rootfs_directory}/usr/lib/shim"
shim_output_directory="${rootfs_directory}/usr/lib/shim"
mkdir -p "$shim_output_directory"

[ -d "$shim_source_directory" ] || panic "directory '$shim_source_directory' does not exist"
[ -d "$shim_output_directory" ] || panic "directory '$shim_output_directory' does not exist"

echo "signing SHIM binaries..."
.aux/sign-efi-directory "$shim_source_directory" "$private_key" "$certificate" "$shim_output_directory"
