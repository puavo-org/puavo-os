#!/bin/sh
# postinst script for puavo-kps-fetcher
#
# see: dh_installdeb(1)

set -e

case "$1" in
  configure)
    # The fetcher talks to the network, so it runs without root
    if ! getent passwd puavo-kps-fetcher >/dev/null; then
      adduser --disabled-login    \
              --disabled-password \
              --group             \
              --no-create-home    \
              --system            \
              puavo-kps-fetcher
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;

  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
