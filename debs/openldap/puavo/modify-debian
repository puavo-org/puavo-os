               quilt,
               time,
               unixodbc-dev <!pkg.openldap.noslapd>,
# Needed for SASL/GSSAPI tests
               krb5-admin-server <!nocheck !pkg.openldap.noslapd>,
               krb5-user <!nocheck !pkg.openldap.noslapd>,
               krb5-kdc <!nocheck !pkg.openldap.noslapd>,
               libsasl2-modules-gssapi-mit <!nocheck !pkg.openldap.noslapd>,
               sasl2-bin <!nocheck !pkg.openldap.noslapd>,
