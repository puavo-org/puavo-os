diff -ruN gnome-shell-extension-gsconnect.0/src/service/device.js gnome-shell-extension-gsconnect.1/src/service/device.js
--- gnome-shell-extension-gsconnect.0/src/service/device.js	2025-03-29 16:00:28.000000000 +0200
+++ gnome-shell-extension-gsconnect.1/src/service/device.js	2026-11-11 13:21:43.216910200 +0200
@@ -101,6 +101,8 @@
         this._outputLock = false;
         this._outputQueue = [];
 
+        this._disconnectedAt = null;
+
         // GSettings
         this.settings = new Gio.Settings({
             settings_schema: Config.GSCHEMA.lookup(
@@ -347,9 +349,38 @@
         if (this.connected === !!this.channel)
             return;
 
+        const wasConnected = this.connected;
+
         // Notify and trigger plugins
         this._connected = !!this.channel;
         this.notify('connected');
+
+        if (wasConnected && !this.connected) {
+            this._disconnectedAt = GLib.get_monotonic_time();
+        }
+
+        if (!wasConnected && this.connected &&
+            this.paired && this.type === 'phone') {
+
+            const now = GLib.get_monotonic_time();
+            const minimumDisconnection = 30 * GLib.USEC_PER_SEC;
+
+            if (this._disconnectedAt === null ||
+                now - this._disconnectedAt >= minimumDisconnection) {
+
+                log(`GSConnect: ${this.name} connected, notifying user`);
+
+                // use unique notification id every time so Gnome will not
+                // drop some because of repetition
+                this.showNotification({
+                    id: `connected-${GLib.get_monotonic_time()}`,
+                    title: _('Phone Connected'),
+                    body: _('%s is now connected').format(this.name),
+                    icon: new Gio.ThemedIcon({name: 'smartphone-symbolic'}),
+                });
+            }
+        }
+
         this._triggerPlugins();
     }
 
