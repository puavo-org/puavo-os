#!/bin/sh

set -eu

if [ "$(id -u)" != '0' ]; then
  echo 'run me as root' >&2
  exit 1
fi

mkdir -p /var/log/puavo/puavo-benchmark
cd /var/log/puavo/puavo-benchmark

rm -f results_all.yml
/opt/PerformanceTest/PerformanceTest -d 1 -r 3

results_filename="passmark-performance-test-$(date -Iseconds).json"
yq . results_all.yml > "$results_filename"
rm -f results_all.yml
