[Desktop Entry]
Type=Application
Name=GSConnect
Exec=puavo-gsconnect preferences
Terminal=false
Icon=org.gnome.Shell.Extensions.GSConnect
Categories=Network;
MimeType=x-scheme-handler/sms;x-scheme-handler/tel;
DBusActivatable=true
X-GNOME-UsesNotifications=true
