{
  "puavo.abitti2.mode": {
    "choices": [ "do-nothing", "install-and-update", "purge" ],
    "default": "purge",
    "description": "The Abitti 2 client installation/removal mode",
    "typehint": "string"
  },
  "puavo.abitti2.version": {
    "default": "latest",
    "description": "The Abitti 2 client version, use latest for the latest version",
    "typehint": "string"
  },
  "puavo.service.puavo-abitti2-torrent-updated.enabled": {
    "default": "false",
    "description": "Enable/disable the torrent-based Abitti 2 client update mechanism",
    "typehint": "bool"
  },
  "puavo.service.puavo-trigger-abitti2-updates.enabled": {
    "default": "false",
    "description": "Enable/disable Abitti 2 client updates",
    "typehint": "bool"
  }
}
