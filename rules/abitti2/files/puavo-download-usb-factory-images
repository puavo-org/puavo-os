}

mkdir -p "$g_puavo_usb_factory_dir"

(
  if ! flock -n 9; then
    logmsg -p user.err 'could not get a lock, exiting...'
    return 1
  fi

  # remove old Abitti 1 stuff
  rm -rf "${g_puavo_usb_factory_dir}/Abitti"     \
         "${g_puavo_usb_factory_dir}/Abitti-KOE" \
         "${g_puavo_usb_factory_dir}/Abitti-KTP"

  write_ui_json

  exitstatus=0

  for this_dir in "$g_abitti2_images_dir" "$g_custom_images_dir"; do
    puavo_conf_key=''
    if [ "$this_abitti_dir" = "$abitti2_images_dir" ]; then
      bg_color='#6392ac'
      image_type='abitti2'
      puavo_conf_key='puavo.abitti2.version'
      ui_png='UI-blue.png'
    else
      bg_color='#5c5c5c'
      image_type='custom'
      ui_png='UI-purple.png'
    fi

    mkdir -p "$this_dir"

    printf "%s\n" "$puavo_conf_key" > "${this_dir}/PUAVOCONF_KEY.tmp"
    mv "${this_dir}/PUAVOCONF_KEY.tmp" "${this_dir}/PUAVOCONF_KEY"

    if ! cmp "/usr/local/share/puavo-download-usb-factory-images/${ui_png}" \
             "${this_dir}/UI.png" >/dev/null 2>&1; then
      cp -p "/usr/local/share/puavo-download-usb-factory-images/${ui_png}" \
            "${this_dir}/UI.png"
    fi

    printf "%s\n" "$bg_color" > "${this_dir}/UI.png.bg_color.tmp"
    mv "${this_dir}/UI.png.bg_color.tmp" "${this_dir}/UI.png.bg_color"

    if $do_setup || [ "$this_dir" != "$g_abitti2_images_dir" ]; then
      continue
    fi

    download_status_path=$(get_download_status_path "$g_abitti2_images_dir")

    if [ "$image_type" = 'custom' ]; then
       echo up-to-date > "$download_status_path"
       continue
    fi

    printf "in progress %s\n" ? > "$download_status_path"

    if ! g_abitti2_server=$(get_abitti2_catalogue) \
      || [ -z "$g_abitti2_server" ]; then
        logmsg -p user.err "error in fetching abitti2.json"
        return 1
    fi

    if ! download_abitti2 "$puavo_conf_key"; then
      logmsg -p user.err "error downloading Abitti to ${g_abitti2_images_dir}"
      echo failed > "$download_status_path"
      exitstatus=1
    else
      echo up-to-date > "$download_status_path"
    fi
  done

  exit $exitstatus
) 9< "$lock_directory"
