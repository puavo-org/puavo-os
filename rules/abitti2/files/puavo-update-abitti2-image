#!/bin/sh

set -eu

abitti2_dir=/images/abitti2
abitti2_json_path="${abitti2_dir}/abitti2.json"

logmsg() {
  logger -s -t puavo-update-abitti2-image "$@" || true
}

errmsg='unknown error'
error() {
  local errmsg

  errmsg=$1
  logmsg -p user.err "$1"
}

get_abitti2_catalogue() {
  local abitti2_json_tmppath abitti2_server abitti2_sources gnupg_dir url

  abitti2_json_tmppath="${abitti2_json_path}.tmp"
  abitti2_sources=$(puavo-conf puavo.abitti2.image.sources)

  for url in $abitti2_sources; do
    if ! wget_with_certauth -q \
      --output-document "$abitti2_json_tmppath" "$url"; then
        echo "error fetching ${url}" >&2
        continue
    fi

# XXX add GPG check later
#   abitti2_server=$(dirname "${url#https://}")
#   gnupg_dir="/root/.puavo/gnupg/${abitti2_server}/abitti2"
#   if ! gpg --decrypt --homedir "$gnupg_dir" "$abitti2_gpg_tmppath" \
#     2>/dev/null > "$wim_tmppath"; then
#       echo "GPG verification failed for ${url}" >&2
#       continue
#   fi

    mv "$abitti2_json_tmppath" "$abitti2_json_path" || return 1
    printf "%s" "${url%/*}" || return 1
    return 0
  done

  echo 'could not fetch any source in puavo.abitti2.image.sources' >&2
  return 1
}

lookup_abitti2_choice() {
  local abitti2_version
  abitti2_version=$1

  jq -r --arg abitti2_version "$abitti2_version" '
    ($abitti2_version as $k | .aliases[$k] // $k) as $resolved
      | .choices[$resolved] // error("no such choice")
  ' "$abitti2_json_path"
}

lookup_abitti2_image_info() {
  local abitti2_image
  abitti2_image=$1

  jq -r --arg abitti2_image "$abitti2_image" '
    .images[$abitti2_image] // error("no such image")
  ' "$abitti2_json_path"
}

lookup_var() {
  local json_str value var
  json_str=$1
  var=$2

  if ! value=$(
    printf %s "$json_str" | jq -r --arg var "$var" '
                              .[$var] // error("no such var")
                            '); then
      error "could not lookup ${var} from json"
      return 1
  fi

  printf %s "$value"
}

wget_with_certauth()
{
   wget --ca-certificate=/etc/puavo-conf/rootca.pem        \
        --certificate=/etc/puavo/certs/hostorgcabundle.pem \
        --private-key=/etc/puavo/certs/host.key            \
        "$@"
}

# obtain an exclusive lock on myself...
# there should be only one instance of this program running
#
# WARNING UGLY CODE We use flock with timeout here, because this might
# be run through puavo-conf-daemon extra-content-updates, which kills
# this process group, and waits for only one pid which might not
# be the only one holding this lock.  Because a new process might
# be immediately starting, it should wait a bit before the lock
# gets actually released.
exec 3<$0
flock -w 10 -x 3 || { error "did not get a lock, exiting"; exit 1; }

if ! mountpoint -q /images; then
  echo '/images is not its own partition, refusing to download abitti 2' >&2
  exit 1
fi

edit_extra_system_contents() {
  local esc_json_path tmpfile

  # XXX should use flock in case there are ever
  # XXX other updaters for this file
  esc_json_path='/var/lib/puavo-desktop/extra_system_contents.json'
  tmpfile="${esc_json_path}.tmp"
  if [ -e "$esc_json_path" ]; then
    jq "$@" "$esc_json_path" > "$tmpfile" || return 1
  else
    jq --null-input "$@" > "$tmpfile" || return 1
  fi
  mv "$tmpfile" "$esc_json_path"
}

post_update_actions() {
  local abitti2_filename abitti2_version abitti2_json_path

  abitti2_filename=$1
  abitti2_version=$2
  abitti2_json_path=$3

  # XXX it should be possible to have two so this is not good
  find "$abitti2_dir" -name '*.iso' \
    -and ! -name "$abitti2_filename" -exec rm -f \{} \;

  edit_extra_system_contents --arg version "$abitti2_version" \
    '.Abitti2 = $version'

  # XXX do we have to use Grub variables for this?
  # XXX the old abitti variables should be cleaned up,
  # XXX maybe Abitti 1 purge should do that, right?
  grub-editenv /images/boot/grub/grubenv \
               set "abitti2_version=${abitti2_version}"
}

send_status_message() {
  local method
  method=$1; shift

  dbus-send --dest=org.puavo.client.Daemon              \
            --reply-timeout=100                         \
            --print-reply=literal                       \
            --system                                    \
            /contentupdates                             \
            "org.puavo.client.contentupdates.${method}" \
            "string:Abitti2"                            \
            "string:${abitti2_version}"                 \
            "$@" \
    || true
}

update_status='not_started'
send_final_status() {
  case "$update_status" in
    not_started)
      exit 0
      ;;
    started)
      send_status_message SetUpdateFailed "string:${errmsg}"
      exit 1
      ;;
    success)
      send_status_message SetUpdateCompleted
      exit 0
      ;;
  esac
  update_status='final_message_sent'
}

update_progress() {
  local phase
  phase=$1

  while read progress; do
    # image_download goes only from 0 --> 90 %.
    if [ "$phase" = 'image_download' ]; then
      progress=$(echo "$progress" | tr -d '\r')
      progress=$(( 90 * $progress / 100 ))
    fi
    send_status_message SetUpdateProgress "int32:${progress}"
  done
}

cleanup_previous_runs() {
  local abitti2_filename

  abitti2_filename=$1

  # Ask puavo-abitti-torrent-updated to stop seeding (if it is doing
  # anything).  This is relevant here only for disk space calculations.
  echo stop | nc -N -U /run/puavo/puavo-abitti2-torrent-updated.sock \
    >/dev/null 2>&1 || true

  # remove temporary files (of non-matching versions).
  find "$abitti2_dir" -type f -name '*.iso.tmp' \
    -a ! -name "${abitti2_filename}.tmp" -exec rm -f \{} \;
}

ensure_enough_available_diskspace() {
  local abitti2_filename abitti2_size available_diskspace msg \
        required_diskspace tmpimage_size

  abitti2_filename=$1
  abitti2_size=$2

  cleanup_previous_runs "$abitti2_filename" || true

  tmpimage_size=$(
    stat -c %s "${abitti2_dir}/${abitti2_filename}.tmp" 2>/dev/null || echo 0)

  required_diskspace=$(($abitti2_size - $tmpimage_size))
  available_diskspace=$(stat -f -c '%S * %a' "$abitti2_dir" \
                          | bc -l | xargs printf %.0f)
  if [ "$available_diskspace" -lt "$required_diskspace" ]; then
    msg="only $available_diskspace bytes available on $abitti2_dir,"
    msg="$msg need $required_diskspace bytes"
    error "$msg"
    return 1
  fi

  msg="${required_diskspace} (required diskspace) <="
  msg="${msg} ${available_diskspace} (available diskspace),"
  msg="${msg} can proceed with Abitti 2 update"
  logmsg -p user.info "$msg"

  return 0
}

do_torrent_update() {
    local abitti2_filename abitti2_size download_rate_limit \
          tmp_abitti2_filename url_to_download_with_torrent

  download_rate_limit=$1
  abitti2_filename=$2
  abitti2_size=$3
  url_to_download_with_torrent=$4

  ensure_enough_available_diskspace "$abitti2_filename" "$abitti2_size" \
    || return 1

  torrent_status=$(
    printf "%s\n%s\n" "$download_rate_limit" "$url_to_download_with_torrent" \
      | nc -N -U /run/puavo/puavo-abitti2-torrent-updated.sock \
      | while read progress; do
          if [ "$progress" = 'OK' ]; then
            printf "OK\n"
          else
            printf "%s\n" "$progress" | update_progress image_download
          fi
        done)
  if [ "$torrent_status" != 'OK' ]; then
    error "could not download ${url_to_download_with_torrent} with torrent"
    return 1
  fi

  logmsg -p user.info "got ${url_to_download_with_torrent} with success"

  return 0
}

# be very nice
ionice -c 3  -p $$
renice -n 20 -p $$ > /dev/null

abitti2_mode=$(puavo-conf puavo.abitti2.mode)
case "$abitti2_mode" in
  do-nothing)
    exit 0
    ;;
  install-and-update)
    # just continue...
    ;;
  purge)
    rm -rf "$abitti2_dir"
    exit 0
    ;;
  *)
    error "unsupported abitti2 mode: '${abitti2_mode}'"
    exit 1
    ;;
esac

if [ "$(puavo-conf puavo.service.puavo-abitti-torrent-updated.enabled)" \
     != 'true' ]; then
  errmsg='puavo-abitti-torrent-updated is not enabled (in puavo-conf)'
  errmsg="${errmsg}, can not update Abitti 2"
  error "$errmsg"
  exit 1
fi

download_rate_limit=''
if [ "${1:-}" = '--use-rate-limit' ]; then
  download_rate_limit=$(puavo-conf puavo.image.download.ratelimit)
  if [ -n "$download_rate_limit" ]; then
    if ! printf "%s\n" "$download_rate_limit" | grep -Eqx '[0-9]+[km]'; then
      error "the rate limit was not understood, got '$download_rate_limit'"
      exit 1
    fi
  fi
fi

puavo_abitti2_version=$(puavo-conf puavo.abitti2.version)
if [ -z "$puavo_abitti2_version" ]; then
  error 'puavo.abitti2.version is not set, doing nothing!'
  exit 1
fi

install -d -D -o root -g puavo-update -m 775 "$abitti2_dir"

if ! abitti2_server=$(get_abitti2_catalogue) || [ -z "$abitti2_server" ]; then
  error 'error fetching the abitti2 catalogue'
  exit 1
fi

if ! abitti2_choice=$(lookup_abitti2_choice "$puavo_abitti2_version"); then
  error 'no such abitti2 version' >&2
  exit 1
fi

abitti2_grub_cfg=$(lookup_var "$abitti2_choice" grub_cfg)
abitti2_image=$(   lookup_var "$abitti2_choice" image)
abitti2_version=$( lookup_var "$abitti2_choice" version)

if ! abitti2_image_info=$(lookup_abitti2_image_info "$abitti2_image"); then
  error 'no such abitti2 version' >&2
  exit 1
fi

abitti2_filename=$(lookup_var "$abitti2_image_info" puavo_os_filename)
abitti2_sha256=$(  lookup_var "$abitti2_image_info" sha256)
abitti2_size=$(    lookup_var "$abitti2_image_info" size)

# "_fp" stands for "full path"
abitti2_iso_fp="${abitti2_dir}/${abitti2_filename}"

if [ -e "$abitti2_iso_fp" ]; then
  msg="the requested abitti-image ${abitti2_filename} (${abitti2_version})"
  msg="${msg} is in place"
  logmsg -p user.info "$msg"
  post_update_actions "$abitti2_filename" "$abitti2_version" \
                      "$abitti2_json_path"
  exit 0
fi

url_to_download_with_torrent="${abitti2_server}/${abitti2_filename}"

# now we are going to update
update_status='started'

# update_status and abitti2_version must be set before this:
trap send_final_status 0 INT TERM

send_status_message SetUpdateStarted

logmsg -p user.info "downloading ${url_to_download_with_torrent}"

echo 0 | update_progress starting

tmp_abitti2_iso_fp="${abitti2_iso_fp}.tmp"

if ! do_torrent_update "$download_rate_limit" "$abitti2_filename" \
  "$abitti2_size" "$url_to_download_with_torrent"; then
    error 'torrent update failed'
    exit 1
fi

echo 90 | update_progress sha256

logmsg -p user.info \
       "checking sha256 checksum of ${abitti2_filename} (${abitti2_version})"

calculated_sha256="$(sha256sum "$tmp_abitti2_iso_fp" \
                       | awk '{ print $1 }')"
if [ "$calculated_sha256" != "$abitti2_sha256" ]; then
  errmsg="calculated checksum for ${abitti2_filename} does not match"
  errmsg="${errmsg} the expected checksum, removing ${tmp_abitti2_iso_fp}"
  error "$errmsg"
  rm -f "$tmp_abitti2_iso_fp"
  exit 1
fi

logmsg -p user.info "checksum for ${abitti2_filename} is good"
mv "$tmp_abitti2_filename" "$abitti2_filename"

echo 99 | update_progress sha256

mv "$tmp_abitti2_iso_fp" "$abitti2_iso_fp"

logmsg -p user.notice \
       "new Abitti2 image ${abitti2_filename} (${abitti2_version}) installed!"

post_update_actions "$abitti2_filename" "$abitti2_version" "$abitti2_json_path"

update_status='success'
