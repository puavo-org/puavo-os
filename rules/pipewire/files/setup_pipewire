#!/bin/sh

set -eu

force_defaults=$(puavo-conf puavo.audio.pipewire.force_default)
default_priorities=$(puavo-conf puavo.audio.pipewire.default)
default_volumes=$(puavo-conf puavo.audio.pipewire.volume)

sink_priorities=$(puavo-conf puavo.audio.pipewire.sink.default)
source_priorities=$(puavo-conf puavo.audio.pipewire.source.default)

sink_volumes=$(puavo-conf puavo.audio.pipewire.sink.volume)
source_volumes=$(puavo-conf puavo.audio.pipewire.source.volume)

[ -z "$sink_priorities"   ] && sink_priorities="$default_priorities"
[ -z "$sink_volumes"      ] && sink_volumes="$default_volumes"
[ -z "$source_priorities" ] && source_priorities="$default_priorities"
[ -z "$source_volumes"    ] && source_volumes="$default_volumes"

wireplumber_dir='/etc/wireplumber/wireplumber.conf.d'
settings_path="${wireplumber_dir}/50-puavo-audio.conf"

mkdir -p "$wireplumber_dir"

jq --null-input -r --arg force_defaults    "$force_defaults"    \
                   --arg sink_priorities   "$sink_priorities"   \
                   --arg sink_volumes      "$sink_volumes"      \
                   --arg source_priorities "$source_priorities" \
                   --arg source_volumes    "$source_volumes" '
  def case_insensitive($s):
    $s
    | split("")
    | map(
        if test("[A-Za-z]")
        then "[" + ascii_upcase + ascii_downcase + "]"
        else .
        end
      )
    | join("");

  def device_match($id):
    if $id | test("^[A-Za-z0-9_]+$") then
      "~.*" + case_insensitive($id) + ".*"
    else
      $id
    end;

  def parse_volume_spec($spec):
    reduce ($spec | split(" ")[] | select(length > 0)) as $item
      (
        { global: null, devices: [] };

        if $item | test("^[0-9]+$") then
          if .global == null then
            .global = $item
          else
            .
          end
        else
          .devices += [$item]
        end
      );

  def priority($id; $s):
    (try ($s | tonumber) catch null) as $v
    | if $v != null and ($v | floor) == $v and $v >= 0 then
        $v
      else
        "warning: invalid priority for \($id): \($s)\n" | stderr | null
      end;

  def priority_rules($spec; $class; $start; $step):
    reduce ($spec | split(" ")[] | select(length > 0)) as $item
      (
        { next: $start, rules: [] };

        ($item | split(":")) as $parts
        | ($parts[0]) as $id
        | (
            if ($parts | length) > 1 then
              priority($id; $parts[1])
            else
              .next
            end
          ) as $priority
        | select($priority != null)
        | .rules += [
            {
              matches: [
                {
                  "media.class": $class,
                  "node.name": device_match($id)
                }
              ],
              actions: {
                "update-props": {
                  "priority.session": $priority
                }
              }
            }
          ]
        | .next = ($priority - $step)
      )
    | .rules;

  def volume($id; $s):
    if ($s | test("^[0-9]+$")) then
      ($s | tonumber) as $v
      | if 0 <= $v and $v <= 100 then
          pow($v / 100; 3)
        else
          "warning: volume out of range for \($id): \($s)\n" | stderr | null
        end
    else
      "warning: invalid volume for \($id): \($s)\n" | stderr | null
    end;

  def volume_rules($devices; $property):
    $devices
    | map(
        split(":") as $parts
        | volume($parts[0]; $parts[1]) as $volume
        | select($volume != null)
        | {
            matches: [
              { "device.name": device_match($parts[0]) }
            ],
            actions: {
              "update-props": {
                ($property): $volume
              }
            }
          }
      );

  parse_volume_spec($sink_volumes) as $sink_volume_spec
  | parse_volume_spec($source_volumes) as $source_volume_spec
  | {
    "monitor.alsa.rules":
      (
        (priority_rules($sink_priorities; "Audio/Sink"; 1400; 100) | reverse)
        + (priority_rules($source_priorities; "Audio/Source"; 2400; 100) | reverse)
        + (volume_rules($sink_volume_spec.devices; "device.routes.default-sink-volume") | reverse)
        + (volume_rules($source_volume_spec.devices; "device.routes.default-source-volume") | reverse)
      ),

    "wireplumber.settings":
      (
        { "node.restore-default-targets": ($force_defaults != "true") }
        +
        (
          if $sink_volume_spec.global != null then
            { "device.routes.default-sink-volume": volume("sink"; $sink_volume_spec.global) }
          else
            {}
          end
        )
        +
        (
          if $source_volume_spec.global != null then
            { "device.routes.default-source-volume": volume("source"; $source_volume_spec.global) }
          else
            {}
          end
        )
      )
  }
  | to_entries[]
  | (.key | @json) + " = ", .value
' > "${settings_path}.tmp"

mv "${settings_path}.tmp" "$settings_path"
