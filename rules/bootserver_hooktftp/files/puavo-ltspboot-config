#!/bin/sh
#
# Get grub.cfg configuration data from the puavo-rest server.
#
# Usage: puavo-ltspboot-config [PXE GET URL]
#
# eg. puavo-ltspboot-config grub.cfg-01-78-e7-d1-d4-0f-5f

set -eu

tftpbase="/var/lib/tftpboot/ltsp"

get_bootparams() {
  # this is the same as
  #   puavo-rest-client --user-bootserver "v3/bootparams_by_mac/$1"
  # but is more efficient (about 0.1 second in real bootserver hardware)
  api_server=$(puavo-resolve-api-server --no-cloud-fallback) || return 1
  curl --cacert /etc/puavo-conf/rootca.pem --silent --fail \
       -H "Authorization: Bootserver" \
        "${api_server}/v3/bootparams_by_mac/$1"
}

pxe_error() {
  errorstring=$1
  cat <<EOF
menuentry "$errorstring" --id error {

}
EOF
  exit 1
}

show_image_menu() {
  local preferred_boot_image default_image_tftpdir_missing

  preferred_boot_image=$1
  default_image_tftpdir_missing=$2

  available_images=$(echo ${tftpbase}/*/vmlinuz \
                        | xargs -n 1 dirname   \
                        | xargs -n 1 basename  \
                        | sort)

  if [ -z "$available_images" ]; then
    pxe_error 'No images on bootserver'
  fi

  image="$preferred_boot_image"
  cat <<HEADER_EOF
set timeout=5

HEADER_EOF

  if $default_image_tftpdir_missing; then
    cat <<DEFAULT_IMAGE_EOF
menuentry "MISSING ${image}" --id ltsp-default-image-notfound {

}
DEFAULT_IMAGE_EOF
  else
    cat <<DEFAULT_IMAGE_EOF
menuentry "${image}" --class os --id ltsp-NBD-${image} {
  linux /ltsp/${image}/vmlinuz ro init=/sbin/init-puavo puavo.hosttype=unregistered root=/dev/nbd0 nbdroot=dhcp,${image},nbd0 netroot=nbd:\$net_default_server:${image} ${kernel_arguments} BOOTIF=01-\$net_default_mac
  initrd /ltsp/${image}/initrd.img
}
DEFAULT_IMAGE_EOF
  fi

  for image in $available_images; do
    test "$image" != "$preferred_boot_image" || continue

    cat <<EOF
menuentry "${image}" --class os --id ltsp-NBD-${image} {
  linux /ltsp/${image}/vmlinuz ro init=/sbin/init-puavo puavo.hosttype=unregistered root=/dev/nbd0 nbdroot=dhcp,${image},nbd0 netroot=nbd:\$net_default_server:${image} ${kernel_arguments} BOOTIF=01-\$net_default_mac
  initrd /ltsp/${image}/initrd.img
}
EOF
  done

  cat <<'EOF'
menuentry 'Local OS' --class os --id local {
  insmod chain
  if [ $grub_platform = "efi" ] ; then
    search --set=root --file /EFI/debian/grubx64.efi
    chainloader /EFI/debian/grubx64.efi
  else
    set root=(hd0)
    chainloader +1
  fi
}
EOF
}

pxegeturl=$1

set -u

if [ -z "$pxegeturl" ]; then
  pxe_error 'PXE url missing'
fi

mac_address=$(printf %s "$pxegeturl" \
  | sed -nr 's/.*01[-:](([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2})$/\1/p' \
  | tr - :)

if [ -z "$mac_address" ]; then
  pxe_error 'PXEGETURL not valid'
fi

if ! host_bootparams=$(get_bootparams "$mac_address"); then
  pxe_error "No configuration for $mac_address"
fi

boot_mode=$(printf %s "$host_bootparams" | jq -r .boot_mode)
hostname=$(printf %s "$host_bootparams" | jq -r .hostname)
hosttype=$(printf %s "$host_bootparams" | jq -r .type)
kernel_arguments=$(printf %s "$host_bootparams" | jq -r .kernel_arguments)
kernel_version=$(printf %s "$host_bootparams" | jq -r .kernel_version)
preferred_boot_image=$(printf %s "$host_bootparams" | jq -r .preferred_boot_image)

[ "$hostname" = "null" -o "$hostname" = '' ] && hostname='unknown'
[ "$hosttype" = "null" -o "$hosttype" = '' ] && hosttype='unregistered'
[ "$kernel_arguments" = "null" ] && kernel_arguments=''
[ "$kernel_version"   = "null" ] && kernel_version=''

if [ -z "$kernel_arguments" ]; then
  kernel_arguments='quiet splash'
fi

# XXX Some hosttype specific special tricks... these are mostly hacks whose
# XXX value should be re-evaluated or possibly solved through some other
# XXX means.
case "$hosttype" in
  fatclient)
    kernel_arguments="${kernel_arguments} hostname=${hostname} preempt=full"
    ;;
  laptop)
    kernel_arguments='iomem=relaxed hostname=${hostname} preempt=full puavo.service.tlp.enabled=true'
    ;;
  unregistered)
    kernel_arguments='iomem=relaxed puavo.service.tlp.enabled=true'
    ;;
esac

tftpdir="${tftpbase}/${preferred_boot_image}"
tftpdir_missing=false
if [ ! -d "$tftpdir" ]; then
  tftpdir_missing=true
fi

if [ "$hosttype" = "unregistered" ]; then
  show_image_menu "$preferred_boot_image" "$tftpdir_missing"
  exit 0
fi

if $tftpdir_missing; then
  pxe_error "Missing ${preferred_boot_image}"
fi

kernel_version_suffix=''
if [ -n "$kernel_version" ] \
  && test -e "${tftpdir}/vmlinuz-${kernel_version}"; then
  kernel_version_suffix="-$kernel_version"
fi

if ! test -e "${tftpdir}/vmlinuz${kernel_version_suffix}"; then
  pxe_error 'No kernel found'
fi

# one more sanity test (also checks the corresponding initrd.img)
if ! test -e "${tftpdir}/initrd.img${kernel_version_suffix}"; then
  # something is wrong, use the default kernel
  kernel_version_suffix=''
fi

boot_header=''
if [ "$boot_mode" = "dualboot" ]; then
  boot_header=$(cat <<'HEADER_EOF'
set default=ltsp-NBD
set timeout=5

menuentry 'Local OS' --class os --id local {
  insmod chain
  if [ $grub_platform = "efi" ] ; then
    search --set=root --file /EFI/debian/grubx64.efi
    chainloader /EFI/debian/grubx64.efi
  else
    set root=(hd0)
    chainloader +1
  fi
}
HEADER_EOF
)
else
  boot_header=$(cat <<'HEADER_EOF'
set default=ltsp-NBD
HEADER_EOF
)
fi

boot_labels=$(cat <<EOF
menuentry "${preferred_boot_image}" --class os --id ltsp-NBD {
  linux /ltsp/${preferred_boot_image}/vmlinuz${kernel_version_suffix} ro init=/sbin/init-puavo puavo.hosttype=${hosttype} root=/dev/nbd0 nbdroot=dhcp,${preferred_boot_image},nbd0 netroot=nbd:\$net_default_server:${preferred_boot_image} ${kernel_arguments} BOOTIF=01-\$net_default_mac
  initrd /ltsp/${preferred_boot_image}/initrd.img${kernel_version_suffix}
}
EOF
)

printf "%s\n" "$boot_header"
echo ""
printf "%s\n" "$boot_labels"
