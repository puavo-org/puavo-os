# Black background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Load the logo image and center it on the screen.
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.width = logo.image.GetWidth();
logo.height = logo.image.GetHeight();
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.width / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.height / 2;
logo.sprite.SetPosition(logo.x, logo.y, 1000);
logo.sprite.SetOpacity(1);

# Load the dot images and compute the geometry for the indicator row below the logo.
progress.dot_off = Image("progress_dot_off.png");
progress.dot_on = Image("progress_dot_on.png");
progress.dot_width = progress.dot_off.GetWidth();
progress.dot_height = progress.dot_off.GetHeight();
progress.dot_spacing = progress.dot_width * 1.1;
progress.count = 5;
progress.width = progress.dot_width * progress.count;
progress.x = Window.GetX() + Window.GetWidth() / 2 - progress.width / 2;
progress.y = logo.y + logo.height + (logo.height / 4);

# Create the dot sprites once, and then animate by switching opacity.
fun initialize_progress_dots() {
	for (i = 0; i < progress.count; i++) {
		progress.dots_off[i].sprite = Sprite(progress.dot_off);
		progress.dots_off[i].x = progress.x + i * progress.dot_spacing;
		progress.dots_off[i].sprite.SetPosition(progress.dots_off[i].x, progress.y, 1000);
		progress.dots_off[i].sprite.SetOpacity(1);

		progress.dots_on[i].sprite = Sprite(progress.dot_on);
		progress.dots_on[i].x = progress.dots_off[i].x;
		progress.dots_on[i].sprite.SetPosition(progress.dots_on[i].x, progress.y, 10000);
		progress.dots_on[i].sprite.SetOpacity(0);
	}
}

fun switch_on_dot(index) {
	progress.dots_off[index].sprite.SetOpacity(0);
	progress.dots_on[index].sprite.SetOpacity(1);
}

fun switch_off_dot(index) {
	progress.dots_off[index].sprite.SetOpacity(1);
	progress.dots_on[index].sprite.SetOpacity(0);
}

fun switch_on_all_dots() {
	for (i = 0; i < progress.count; i++) {
		switch_on_dot(i);
	}
}

fun switch_off_all_dots() {
	for (i = 0; i < progress.count; i++) {
		switch_off_dot(i);
	}
}

# Track the current UI mode and the animation state.
status = "normal";
global.last_dot_update = NULL;
global.dots_switched = 0;
global.dots_on = 1;

# Place boot messages under the dots so they do not overlap the logo.
message_sprite = Sprite();
message.y = progress.y + progress.dot_height + 48;

fun display_message_callback(text) {
	local.text_image;
	text_image = Image.Text(text, 1, 1, 1);
	message_sprite.SetImage(text_image);
	message.x = Window.GetX() + Window.GetWidth() / 2 - text_image.GetWidth() / 2;
	message_sprite.SetPosition(message.x, message.y, 10000);
}

fun hide_message_callback(text) {
	message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# This callback is called repeatedly during boot. We use elapsed time to drive the animation.
fun boot_progress_callback(elapsed, progress_value) {
	# Initialize sprites on the first call.
	if (global.last_dot_update == NULL) {
		global.last_dot_update = elapsed;
		initialize_progress_dots();
	}

	# Update the animation every second.
	if ((elapsed - global.last_dot_update) >= 1.0) {
		global.last_dot_update = elapsed;

		# Once we have stepped over every dot, flip the direction by toggling the on/off mode.
		if (global.dots_switched == progress.count) {
			global.dots_on = !global.dots_on;
			global.dots_switched = 0;
		}

		# Switch exactly one dot per tick to create a scanning effect.
		if (global.dots_on) {
			switch_on_dot(global.dots_switched);
		} else {
			switch_off_dot(global.dots_switched);
		}

		global.dots_switched++;
	}
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

# Load an image from the shared Plymouth themes directory and display it.
fun show_image() {
	local.image;
	# NOTE: Absolute paths do not appear to work
	image = Image("../image.png");

	if (image.GetWidth() == 0) {
		return;
	}

	global.overlay_image.sprite = Sprite(image);
	global.overlay_image.sprite.SetPosition(
		Window.GetX(),
		Window.GetY(),
		20000
	);
	global.overlay_image.sprite.SetOpacity(1);
}

# Update status callback
fun update_status_callback(status) {
	if (status == "show-image") {
		show_image();
	}
}

Plymouth.SetUpdateStatusFunction(update_status_callback);

fun input_dialog_prompt(prompt) {
	dialog.prompt.image = Image.Text(prompt, 1, 1, 1);
	dialog.prompt.sprite = Sprite(dialog.prompt.image);
	dialog.prompt.x = Window.GetX() + Window.GetWidth() / 2 - dialog.prompt.image.GetWidth() / 2;
	dialog.prompt.y = progress.y + progress.dot_height + 128;
	dialog.prompt.sprite.SetPosition(dialog.prompt.x, dialog.prompt.y, 10000);
}

# Input field dialog for password and question prompts
fun input_dialog_setup(prompt) {
	local.bullet_image;
	local.field;
	local.field_value;

	bullet_image = Image("password_dot.png");
	field.image = Image("password_field.png");

	# Prompt label
	input_dialog_prompt(prompt);

	# Input field
	field.sprite = Sprite(field.image);
	field.x = Window.GetX() + Window.GetWidth() / 2 - field.image.GetWidth() / 2;
	field.y = dialog.prompt.y + dialog.prompt.image.GetHeight() + 10;
	field.z = 10000;
	field.sprite.SetPosition(field.x, field.y, field.z);

	# Input field value
	field_value.sprite = Sprite();

	global.dialog.field = field;
	global.dialog.field_value = field_value;
	global.dialog.bullet_image = bullet_image;
	input_dialog_opacity(1);
}

fun input_dialog_opacity(opacity) {
	if (global.dialog.prompt.sprite) {
		dialog.prompt.sprite.SetOpacity(opacity);
	}
	if (global.dialog.field.sprite) {
		dialog.field.sprite.SetOpacity(opacity);
	}
	if (global.dialog.field_value.sprite) {
		dialog.field_value.sprite.SetOpacity(opacity);
	}
	for (i = 0; dialog.bullets[i]; i++) {
		dialog.bullets[i].sprite.SetOpacity(opacity);
	}
}

fun input_dialog_bullets(bullet_count) {
	bullet_width = dialog.bullet_image.GetWidth();
	bullet_stride = bullet_width / 2.05; # Yes, it is a magic constant, but now the bullets fit better
	bullet_y = dialog.field.y + dialog.field.image.GetHeight() / 2 - dialog.bullet_image.GetHeight() / 2;
	margin = bullet_width / 2.0;
	max_bullet_count = Math.Int((dialog.field.image.GetWidth() - margin * 2) / bullet_stride);

	if (bullet_count > max_bullet_count) {
		bullet_count = max_bullet_count;
	}

	bullets_x = dialog.field.x + margin / 2.0;

	for (i = 0; dialog.bullets[i] || i < bullet_count; i++) {
		if (!dialog.bullets[i]) {
			dialog.bullets[i].sprite = Sprite(dialog.bullet_image);
			dialog.bullets[i].x = bullets_x + i * bullet_stride;
			dialog.bullets[i].y = bullet_y;
			dialog.bullets[i].z = dialog.field.z + 1;
			dialog.bullets[i].sprite.SetPosition(dialog.bullets[i].x, dialog.bullets[i].y, dialog.bullets[i].z);
		}

		if (i < bullet_count) {
			dialog.bullets[i].sprite.SetOpacity(1);
		} else {
			dialog.bullets[i].sprite.SetOpacity(0);
		}
	}
}

fun input_dialog_field_value(text) {
	margin = 16;
	max_width = global.dialog.field.image.GetWidth() - margin * 2.0;

	# Assume characters can have different sizes, handle overflow.
	# Unfortunately, I did not manage to get the Crop method working.
	for (i = text.Length(); i >= 0; i--) {
		text_image = Image.Text(text.SubString(0, i), 0, 0, 0);

		if (text_image.GetWidth() <= max_width) {
			break;
		}
	}

	dialog.field_value.sprite.SetImage(text_image);

	# Update the position of the field value text
	dialog.field_value.x = dialog.field.x + margin;
	dialog.field_value.y = dialog.field.y + dialog.field.image.GetHeight() / 2.0 - text_image.GetHeight() / 2.0;
	dialog.field_value.z = dialog.field.z + 1;
	dialog.field_value.sprite.SetPosition(dialog.field_value.x, dialog.field_value.y, dialog.field_value.z);
}

fun display_password_input(prompt, bullet_count) {
	if (!global.dialog) {
		input_dialog_setup(prompt);
	} else {
		input_dialog_opacity(1);
	}

	input_dialog_prompt(prompt);
	input_dialog_field_value("");
	input_dialog_bullets(bullet_count);
}

fun display_question_input(prompt, value) {
	if (!global.dialog) {
		input_dialog_setup(prompt);
	} else {
		input_dialog_opacity(1);
	}

	input_dialog_prompt(prompt);
	input_dialog_field_value(value);
	input_dialog_bullets(0);
}

# Password callback
fun display_password_callback(prompt, bullet_count) {
	global.status = "password";
	display_password_input(prompt, bullet_count);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Question callback
fun display_question_callback(prompt, value) {
	global.status = "question";
	display_question_input(prompt, value);
}

Plymouth.SetDisplayQuestionFunction(display_question_callback);

# Normal display callback
fun display_normal_callback() {
	global.status = "normal";
	if (global.dialog) {
		input_dialog_opacity(0);
	}
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Plymouth may ask us to refresh the screen. Update positions and visibility.
fun refresh_callback() {
	logo.sprite.SetPosition(logo.x, logo.y, 1000);
	logo.sprite.SetOpacity(1);
}

Plymouth.SetRefreshFunction(refresh_callback);

# Quit callback
fun quit_callback() {
	logo.sprite.SetOpacity(1);
	if (global.progress_time != NULL) {
		switch_on_all_dots();
	}
}

Plymouth.SetQuitFunction(quit_callback);
