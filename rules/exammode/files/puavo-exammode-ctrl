#!/bin/sh

set -eu

case "${1:-}" in
  start)
    dbus-send --session                  \
              --dest=org.puavo.ExamSetup \
              --print-reply=literal      \
              --type=method_call         \
              /org/puavo/ExamSetup       \
              org.puavo.ExamSetup.Start
    ;;
  *)
    echo "Usage: $(basename $0) start" >&2
    exit 1
    ;;
esac
