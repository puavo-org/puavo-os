#!/bin/sh

set -eu

mode="${1:-}"

case "$mode" in
  start)
    dbus-send --dest=org.puavo.Exam \
              --print-reply=literal \
              --reply-timeout=30000 \
              --system              \
              /exammode org.puavo.Exam.exammode.StartFreeSession
    ;;
  start-url)
    url="${2:-}"
    dbus-send --dest=org.puavo.Exam \
              --print-reply=literal \
              --reply-timeout=30000 \
              --system              \
              /exammode org.puavo.Exam.exammode.StartSessionWithUrl \
              "string:${url}"
    ;;
  *)
    echo "Usage: $(basename $0) start" >&2
    exit 1
    ;;
esac
