#!/bin/sh

set -eu

locale=$(puavo-conf puavo.l10n.locale)
if [ -z "$locale" ]; then
  locale='en_GB.UTF-8'
fi

session_path='/var/lib/puavo-exammode/session.json'

jq --null-input --arg locale "$locale" '
    .locale = $locale
  | .manager = false
  | .name = "Exam mode"
  | .params = {}
  | .type = "free-exammode-session"
' > "${session_path}.tmp"
mv "${session_path}.tmp" "$session_path"
