#!/bin/sh

if [ "$(tty)" = '/dev/tty42' ]; then
  clear

  additional_bwrap_args=''
  # /anon exists only when guest user is enabled
  if [ -d /anon ]; then
    additional_bwrap_args='--tmpfs /anon'
  fi

  exec env HOME=/var/lib/puavo-exammode/user      \
    bwrap --dev-bind / /                          \
          $additional_bwrap_args                  \
          --tmpfs    /home                        \
          --tmpfs    /images                      \
          --tmpfs    /state                       \
          --tmpfs    /tmp                         \
          --tmpfs    /var/lib/puavo-exammode/user \
          --tmpfs    /var/tmp                     \
      startx /usr/local/lib/puavo-exammode/exammode-session -- :42 > /dev/null 2>&1
fi

exec /bin/bash
