#!/bin/sh

set -eu

# no homedir cleanups on netboot devices
[ -e /run/puavo/nbd-server ] && exit 0

logmsg() {
  logger -t puavo-cleanup-homedirs "$@" || true
}

ensure_free_space=$(puavo-conf puavo.admin.cleanup.homedirs.ensure_free_space)
if [ "$ensure_free_space" != 'true' ]; then
  exit 0
fi

personally_administered="$(puavo-conf puavo.admin.personally_administered)"
if [ "$personally_administered" = 'true' ]; then
  exit 0
fi

logmsg -p user.notice 'activating...'

freespace_min=$(puavo-conf puavo.admin.cleanup.homedirs.freespace_min)
if ! echo "$freespace_min" | grep -Eqx '[0-9]+'; then
  logmsg -p user.err \
         'puavo.admin.cleanup.homedirs.freespace_min is not a number'
  exit 1
fi

save_homedir_exception=''
if [ -n "${PAM_USER:-}" ]; then
  save_homedir_exception="${PAM_USER:-}"
fi

get_freespace_amount() {
  stat -f -c '%S * %a' /home | bc -l
}

lookup_oldest_homedir() {
  find /home -maxdepth 1 -mindepth 1 ! -type l \
    -a ! -name "$save_homedir_exception" -printf '%T@ %f\0' \
      | sort -nz | awk '
                     BEGIN { RS = "\0" }
                     $2 ~ /^[A-Za-z0-9][A-Za-z0-9_.:+-]*$/ { print "/home/" $2; exit(0) }
                   '
}

while true; do
  freespace_amount=$(get_freespace_amount)
  logmsg -p user.info \
         "/home has ${freespace_amount} bytes of free space, expecting ${freespace_min} bytes"
  if [ "$freespace_amount" -ge "$freespace_min" ]; then
    logmsg -p user.info '/home has enough free space'
    break
  fi

  oldest_homedir=$(lookup_oldest_homedir)
  if [ -z "$oldest_homedir" ]; then
    logmsg -p user.info \
           'oldest homedir could not be found, perhaps there is nothing under /home?'
    break
  fi

  logmsg -p user.info \
         "not enough free space on /home, removing ${oldest_homedir}: last modified on '$(stat -c %y "$oldest_homedir" || true)'"
  rm -rf --one-file-system -- "$oldest_homedir"
done

exit 0
