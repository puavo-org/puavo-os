#!/bin/sh

set -eu

# no homedir cleanups (or reports) on netboot devices
[ -e /run/puavo/nbd-server ] && exit 0

[ -n "${GUEST_SESSION:-}" ] && exit 0

if [ "$(puavo-conf puavo.admin.cleanup.homedirs.ensure_free_space)" != 'true' ]; then
  exit 0
fi

if [ "$(puavo-conf puavo.admin.personally_administered)" = 'true' ]; then
  exit 0
fi

case "$LANG" in
  de*)
    summary='AUTOMATISCHES LÖSCHEN VON DATEIEN'
    body='Dateien bitte ins Netzlaufwerk oder in die Cloud speichern – Speicherplatz wird bei Bedarf automatisch bereinigt.'
    ;;
  fi*)
    summary='AUTOMAATTINEN TALLENNUSTILAN HALLINTA'
    body='Tallennathan tiedostosi verkkolevylle tai pilvipalveluun – tämän laitteen levytilaa siivotaan automaattisesti, jos se käy vähiin.'
    ;;
  fr*)
    summary='SUPPRESSION AUTOMATIQUE DES FICHIERS'
    body="Enregistrez vos fichiers sur le réseau ou dans le cloud – l’espace disque est nettoyé automatiquement si nécessaire."
    ;;
  sv*)
    summary='AUTOMATISK RADERING AV FILER'
    body='Spara dina filer på nätverksenheten eller i en molntjänst – den här enhetens diskutrymme rensas automatiskt om det blir fullt.'
    ;;
  *)
    summary='AUTOMATIC FILE DELETION'
    body='Please save your files to the network drive or cloud – this device’s disk space is cleaned up automatically if it runs low.'
    ;;
esac

notify-send -i system-devices-panel-alert "$summary" "$body"
