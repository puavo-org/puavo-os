{
  "patterns": [
    "usr/lib/grub/x86_64-efi-signed/*.efi.signed",
    "usr/lib/grub/i386-efi-signed/*.efi.signed",

    "usr/lib/shim/*.efi.signed",

    "boot/kernel-*.uki.efi",
    "boot/kernel-*.uki.efi.bsdiff",
    "boot/addons/*.efi",

    "etc/puavo-conf/tpm2-pcr-public-key*.pem",
    "etc/puavo-conf/secure-boot*.der"
  ],
  "expected_components": [
    "usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed",
    "usr/lib/grub/i386-efi-signed/grubia32.efi.signed",

    "usr/lib/shim/fbx64.efi.signed",
    "usr/lib/shim/mmx64.efi.signed",
    "usr/lib/shim/shimx64.efi.signed",

    "boot/kernel-6.12.90+deb13.1-amd64.uki.efi",
    "boot/kernel-6.12.90+deb13.1-amd64.uki.efi.bsdiff",
    "boot/kernel-7.0.10+deb13-amd64.uki.efi",
    "boot/kernel-7.0.10+deb13-amd64.uki.efi.bsdiff",
    "boot/addons/bootserver.addon.efi",
    "boot/addons/diskinstaller.addon.efi",
    "boot/addons/exam.addon.efi",
    "boot/addons/laptop.addon.efi",
    "boot/addons/preinstalled.addon.efi",

    "etc/puavo-conf/tpm2-pcr-public-key.pem",

    "etc/puavo-conf/secure-boot.der"
  ],
  "secure_boot_certificate_patterns": ["secure-boot.pem"],
  "tpm_pcr_public_key_patterns": ["tpm2-pcr-public-key*.pem"],
  "installed_keys": ["secure-boot.der", "tpm2-pcr-public-key.pem"]
}
