{
  "patterns": [
    "usr/lib/grub/puavo/x86_64-efi/*.efi.signed",
    "usr/lib/grub/puavo/i386-efi/*.efi.signed",
    "usr/lib/grub/puavo-netboot/*.efi.signed",

    "usr/lib/slab/*.efi.signed",

    "boot/kernel-*.uki.efi",
    "boot/kernel-*.uki.efi.bsdiff",
    "boot/addons/*.efi",

    "etc/puavo-conf/tpm2-pcr-public-key*.pem",
    "etc/puavo-conf/secure-boot*.der",

    "var/lib/tftpboot/slabx64.efi",
    "var/lib/tftpboot/efi64/grubx64.efi"
  ],
  "expected_components": [
    "usr/lib/grub/puavo/x86_64-efi/grubx64.efi.signed",
    "usr/lib/grub/puavo/i386-efi/grubia32.efi.signed",
    "usr/lib/grub/puavo-netboot/grubx64.efi.signed",

    "usr/lib/slab/slabx64.efi.signed",

    "boot/kernel-6.12.101+deb13.1-amd64.uki.efi",
    "boot/kernel-6.12.101+deb13.1-amd64.uki.efi.bsdiff",
    "boot/kernel-7.1.3+deb13-amd64.uki.efi",
    "boot/kernel-7.1.3+deb13-amd64.uki.efi.bsdiff",
    "boot/addons/bootserver.addon.efi",
    "boot/addons/diskinstaller.addon.efi",
    "boot/addons/exam.addon.efi",
    "boot/addons/laptop.addon.efi",
    "boot/addons/preinstalled.addon.efi",

    "etc/puavo-conf/tpm2-pcr-public-key.pem",

    "etc/puavo-conf/secure-boot.der",

    "var/lib/tftpboot/slabx64.efi",
    "var/lib/tftpboot/efi64/grubx64.efi"
  ],
  "secure_boot_certificate_patterns": ["secure-boot.pem"],
  "tpm_pcr_public_key_patterns": ["tpm2-pcr-public-key*.pem"],
  "installed_keys": ["secure-boot.der", "tpm2-pcr-public-key.pem"]
}
