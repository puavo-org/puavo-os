dn: olcDatabase=mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: mdb
olcSuffix: <%= @suffix %>
olcRootDN: uid=admin,<%= @suffix %>
olcLastMod: TRUE
olcDbCheckpoint: 64 5
olcDbMaxReaders: 4096
olcDbMaxSize: 40000000000
olcDbIndex: cn eq,sub
olcDbIndex: creatorsName eq
olcDbIndex: displayName sub
olcDbIndex: entryCSN eq
olcDbIndex: gidNumber eq
olcDbIndex: givenName sub
olcDbIndex: homeDirectory eq
olcDbIndex: krbPrincipalName eq
olcDbIndex: member eq
olcDbIndex: memberUid eq
olcDbIndex: objectClass eq
olcDbIndex: puavoAdminOfSchool eq
olcDbIndex: puavoDevicePrimaryUser eq
olcDbIndex: puavoDeviceType eq
olcDbIndex: puavoEduGroupType eq
olcDbIndex: puavoEduPersonAffiliation eq
olcDbIndex: puavoExternalId eq
olcDbIndex: puavoHostname eq
olcDbIndex: puavoId eq
olcDbIndex: puavoPrinterQueue eq
olcDbIndex: puavoSchoolAdmin eq
olcDbIndex: puavoSchool eq
olcDbIndex: puavoServiceDomain eq
olcDbIndex: puavoWirelessPrinterQueue eq
olcDbIndex: sn sub
olcDbIndex: uid eq,sub
# Do not add interval= here. When it follows type=refreshAndPersist, slapd
# 2.5/2.6 sets the syncrepl task interval to 0, which makes the listener
# thread busy-loop after a restart (OpenLDAP ITS#9878,
# https://bugs.openldap.org/show_bug.cgi?id=9878). Without interval=, slapd
# uses its 60 s default; reconnects are controlled by retry=.
olcSyncRepl: rid=<%= @rid %> provider="ldap://<%= @master_server %>" binddn="<%= @binddn %>" bindmethod=simple credentials="<%= @bindpw %>" searchbase="<%= @suffix %>" type=refreshAndPersist retry="15 +" timeout=30 starttls=critical tls_cacert=/etc/ssl/certs/puavo-ca.crt schemachecking=off scope=sub
olcUpdateRef: ldap://<%= @master_server %>
olcDbNosync: TRUE
olcDbDirectory: <%= @directory %>
