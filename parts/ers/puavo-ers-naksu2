#!/bin/sh

set -eu

is_abitti2_server() {
  [ "$(puavo-conf puavo.ers.mode)" = 'abitti2server' ]
}

setup_naksu2_configuration() {
  local config_path interface naksu2dir
  interface=$1
  naksu2dir="${HOME}/.local/share/digabi/naksu2"
  mkdir -p "$naksu2dir"
  config_path="${naksu2dir}/naksu2-config.json"

  {
    cat "$config_path" 2>/dev/null \
      || jq --null-input '.screen = "Settings"'
  } | jq --arg interface "$interface" '
      .networkInterface = {
        iface: $interface,
        ifaceName: $interface
      }
    ' > "${config_path}.tmp"
  mv "${config_path}.tmp" "$config_path"
}

network_interface=${1:-}

workdir="${HOME}/.puavo/puavo-ers/naksu2"

logger -p user.notice -t puavo-ers-naksu2 \
       "preparing to run naksu2 in '${workdir}'"

if ! mkdir -p "$workdir"; then
  logger -p user.err -t puavo-ers-naksu2 "could not create '${workdir}'"
  exit 1
fi

if ! which naksu2 >/dev/null; then
  logger -p user.err -t puavo-ers-naksu2 'naksu2 not found'
  exit 1
fi

if ! docker compose version >/dev/null; then
  logger -p user.err -t puavo-ers-naksu2 'docker compose is missing'
  exit 1
fi

if is_abitti2_server; then
  if ! network_interface=$(puavo-conf puavo.ers.abitti2server.interface) \
    || [ -z "$network_interface" ]; then
      logger -p user.err -t puavo-ers-naksu2 \
             'naksu2 is together with server but no known interface'
      exit 1
  fi
  setup_naksu2_configuration "$network_interface"
fi

cd "$workdir"

while true; do
  logger -p user.notice -t puavo-ers-naksu2 'starting up naksu2'
  if ! /usr/bin/terminator -T 'naksu2 terminal' \
       --no-dbus "--working-directory=${workdir}" -x naksu2; then
    logger -p user.err -t puavo-ers-naksu2 'naksu2 failed'
  fi
  sleep 5
done
