def puavoconf_get(puavoconf_key):
    # We do this first to see if we get an error... if this puavo-conf
    # key does not exist, this raises an exception.
    default_value = subprocess.check_output([ 'puavo-conf', puavoconf_key ]) \
                              .rstrip().decode('utf-8')
    try:
        with open('/state/etc/puavo/local/puavo_conf.json') as file:
            conf = json.load(file)
        return conf[puavoconf_key]
    except:
        # Fallback value from puavo-conf if local value could not be read.
        return default_value


BOOT_KEYMAPS_PATH = \
    '/usr/lib/dracut/modules.d/80puavo-boot-trust-manager/keymaps'


def boot_keymaps():
    """The keymaps the boot environment supports."""
    try:
        with open(BOOT_KEYMAPS_PATH) as file:
            return file.read().split()
    except OSError:
        return []


def command_output(command):
    try:
        return subprocess.check_output(
            command, stderr=subprocess.DEVNULL, text=True).strip()
    except (OSError, subprocess.SubprocessError):
        return None


def configured_boot_keymap():
    return command_output(
        ['/usr/lib/puavo-ltsp-install/puavo-read-boot-keymap']) or ''


def active_boot_keymap():
    keymaps = boot_keymaps()
    configured = configured_boot_keymap()

    if configured in keymaps:
        return configured

    # Without a configured keymap the device uses the first one.
    return keymaps[0] if keymaps else ''


def we_have_windows():
    return os.path.exists('/images/boot/.puavo_windows_partition')


def is_encrypted_installation():
    try:
        result = subprocess.check_output(
            ['/usr/lib/puavo-ltsp-install/is-encrypted-install', '/images'],
            stderr=subprocess.PIPE,
            text=True
        )
        return result.strip() == 'true'
    except subprocess.CalledProcessError:
        return False
    except FileNotFoundError:
        return False


