        try:
            versions_by_alias = self.get_abitti_alias_versions()
            return versions_by_alias[alias]
        except Exception as e:
            print('could not read the Abitti version for alias %s: %s' \
                    % (alias, e),
                  file=sys.stderr)
            raise e


