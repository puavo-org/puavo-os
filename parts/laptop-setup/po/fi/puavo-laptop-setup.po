# translations for aliases
#: puavo-laptop-setup:29
msgid "latest"
msgstr "uusin"

#: puavo-laptop-setup:29
msgid "stable"
msgstr "vakaa"

#: puavo-laptop-setup:29
msgid "penultimate"
msgstr "toiseksi viimeisin"

#: puavo-laptop-setup:29
