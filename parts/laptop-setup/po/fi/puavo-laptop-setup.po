# translations for aliases
#: puavo-laptop-setup:25
msgid "latest"
msgstr "uusin"

#: puavo-laptop-setup:25
msgid "stable"
msgstr "vakaa"

#: puavo-laptop-setup:25
msgid "penultimate"
msgstr "toiseksi viimeisin"

#: puavo-laptop-setup:25
msgid "test"
msgstr "testi"

