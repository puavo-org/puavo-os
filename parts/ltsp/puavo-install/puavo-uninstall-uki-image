#!/bin/sh

set -eu

usage() {
  echo "Usage: $0 <install-image> <install-mountpoint>" >&2
  exit 1
}

[ $# -eq 2 ] || usage

install_image="$1"
install_mountpoint="$2"

if [ ! -f "$install_image" ]; then
  echo "error: install image '$install_image' does not exist" >&2
  exit 1
fi

image_mountpoint='/images/mnt'
mkdir -p "$image_mountpoint"

cleanup() {
  umount /boot/efi 2>/dev/null || true
  umount "$image_mountpoint" 2>/dev/null || true
}
trap cleanup EXIT

# Mount the image read-only
mount -o ro "$install_image" "$image_mountpoint"

if ! image_name=$(cat "${image_mountpoint}/etc/puavo-image/name") \
  || [ -z "$image_name" ]; then
    echo 'error: could not lookup image name' >&2
    exit 1
fi
image_name_no_suffix=${image_name%.img}

# Identify boot disks and remove UKI files from their EFI partitions
boot_disks=$(/usr/lib/puavo-core/puavo-get-boot-disks "$install_mountpoint")

status=0

for diskdev in $boot_disks; do
  efi_devpath=$(lsblk -n -l -o PATH,PARTTYPE "$diskdev" \
    | awk '$2 == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; exit(0) }')
  [ -z "$efi_devpath" ] && continue

  echo "removing old UKI files from boot device ${diskdev}"

  efi_mount='/boot/efi'
  mkdir -p "$efi_mount"
  if ! mount "$efi_devpath" "$efi_mount"; then
    echo "could not mount ${efi_devpath} to ${efi_mount}" >&2
    status=1
    continue
  fi

  uki_root="${efi_mount}/EFI/puavo"
  uki_kernels_dir="${uki_root}/${image_name_no_suffix}"
  if ! rm --one-file-system -rf "$uki_kernels_dir"; then
    echo "error in removing ${uki_kernels_dir}" >&2
    status=1
  fi

  umount "$efi_mount" || true
done

exit $status
