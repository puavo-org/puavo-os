#!/bin/sh

set -eu

# Verify Secure Boot prerequisites
/usr/lib/puavo-ltsp-install/puavo-prepare-secure-boot

certificates_directory="/etc/puavo-secure-boot/certificates"
images_directory="/images"
addons_directory="${images_directory}/boot/addons"

pk_auth="${certificates_directory}/pk/PK.auth"
kek_auth="${certificates_directory}/kek/KEK.auth"
db_directory="${certificates_directory}/db"
db_auth="${db_directory}/db.auth"
dbx_bin="${certificates_directory}/dbx/dbx.bin"
device_secure_boot_key_der="${addons_directory}/secure-boot.der"

panic() {
  printf "%b\n" "error: $1" >&2
  exit 1
}

remove_immutability() {
  local f
  for f in "$@"; do
    test -f "$f" || continue
    chattr -i "$f" || return 1
  done
}

[ -f "$pk_auth" ]                    || panic "PK.auth not found"
[ -f "$kek_auth" ]                   || panic "KEK.auth not found"
[ -f "$db_auth" ]                    || panic "db.auth not found"
[ -f "$dbx_bin" ]                    || panic "dbx.bin not found"
[ -f "$device_secure_boot_key_der" ] || panic "device Secure Boot key not found"

# Remove immutability from Secure Boot variables to allow writing.
# They become immutable after each write.
remove_immutability /sys/firmware/efi/efivars/dbx-* \
                    /sys/firmware/efi/efivars/db-*  \
                    /sys/firmware/efi/efivars/KEK-* \
                    /sys/firmware/efi/efivars/PK-*

echo "enrolling Secure Boot keys..."

efi-updatevar -a -f "$dbx_bin" dbx || panic "failed to append dbx"
efi-updatevar -f "$db_auth" db || panic "failed to enroll db"

# Trust all DER certificates in the db directory
for der_file in "${db_directory}"/*.der; do
  [ -f "$der_file" ] || continue
  remove_immutability /sys/firmware/efi/efivars/db-*
  efi-updatevar -a -c "$der_file" db || \
    panic "failed to append $(basename "$der_file") to db"
done

# Trust the device Secure Boot key
remove_immutability /sys/firmware/efi/efivars/db-*
efi-updatevar -a -c "$device_secure_boot_key_der" db || \
  panic "failed to append device Secure Boot key to db"

efi-updatevar -f "$kek_auth" KEK || panic "failed to enroll KEK"
efi-updatevar -f "$pk_auth" PK || panic "failed to enroll PK"

echo "Secure Boot configured successfully"
exit 0
