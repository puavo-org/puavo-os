#!/bin/sh
set -eu

UKI_ROOT="/boot/efi/EFI/debian"
PUAVO_INSTALL_LIBDIR="/usr/lib/puavo-ltsp-install"

usage() {
  echo "Usage: $0 <images-dir>" >&2
  exit 1
}

find_efi_device_path() {
  local diskdev="$1"

  lsblk -n -l -o PATH,PARTTYPE "$diskdev" \
    | awk '$2 == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; exit(0) }'
}

mount_disk_efi_partition() {
  local diskdev="$1"

  efi_devpath=$(find_efi_device_path "$diskdev")
  if [ -z "$efi_devpath" ]; then
    echo "error: failed to find EFI partition in ${diskdev}" >&2
    return 1
  fi

  mount "$efi_devpath" /boot/efi 1>/dev/null
}

cleanup() {
  umount /boot/efi 2>/dev/null || true
}

trap cleanup EXIT

[ $# -eq 1 ] || usage
images_dir=$1

if ! mountpoint -q "$images_dir"; then
  echo "error: '${images_dir}' is not mounted" >&2
  exit 1
fi

boot_disks=$("$PUAVO_INSTALL_LIBDIR"/puavo-get-boot-disks "$images_dir")

if [ -z "$boot_disks" ]; then
  echo "error: failed to find boot disks" >&2
  exit 1
fi

is_uki_install=""

for diskdev in $boot_disks; do
  mount_disk_efi_partition "$diskdev"

  # Check if the disk contains UKI installation
  is_uki_disk="0"

  if find "$UKI_ROOT" -type f -name '*.uki.efi' | grep -q .; then
    is_uki_disk="1"
  fi

  umount /boot/efi || true

  # Update the result and ensure it stays consistent
  if [ -z "$is_uki_install" ]; then
    is_uki_install="$is_uki_disk"
  elif [ "$is_uki_install" != "$is_uki_disk" ]; then
    echo "error: inconsistent UKI installation state detected on $diskdev" >&2
    exit 1
  fi
done

echo "$is_uki_install"
