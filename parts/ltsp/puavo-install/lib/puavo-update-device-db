#!/bin/sh
# Builds db.auth in a directory of device keys. The database holds the
# device certificate followed by the database of the image, and is signed
# with the device KEK. Also writes db.enrolled.json.
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <key-directory>" >&2
  exit 1
fi

keys_directory=$1
secure_boot_directory=/etc/puavo-secure-boot
guid='7cb44677-9bb9-4504-bb8f-923def5fa3b1'

db_pem="${keys_directory}/secure-boot.pem"
kek_private_key="${keys_directory}/kek.priv"
kek_pem="${keys_directory}/kek.pem"
db_auth="${keys_directory}/db.auth"
db_enrolled="${keys_directory}/db.enrolled.json"

image_db_esl="${secure_boot_directory}/db.esl"
built_file="${secure_boot_directory}/built"

panic() {
  echo "error: $1" >&2
  exit 1
}

for file in "$db_pem" "$kek_private_key" "$kek_pem" "$image_db_esl" \
            "$built_file"; do
  [ -f "$file" ] || panic "${file} not found"
done

# The firmware rejects an update whose timestamp is not later than the stored
# one, so the date comes from the database, not from the clock of this machine.
built=$(cat "$built_file")
case $built in
  [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
  *)
    panic "'${built}' in ${built_file} is not a build date in the form YYYYMMDDHHMMSS"
    ;;
esac
signed_at=$(echo "$built" \
  | sed -E 's/(....)(..)(..)(..)(..)(..)/\1-\2-\3 \4:\5:\6/')

scratch=$(mktemp -d)
cleanup() { rm -rf "$scratch"; }
trap cleanup EXIT INT TERM

db_esl="${scratch}/db.esl"
cert-to-efi-sig-list -g "$guid" "$db_pem" "$db_esl"
cat "$image_db_esl" >> "$db_esl"

sign-efi-sig-list -t "$signed_at" -k "$kek_private_key" -c "$kek_pem" \
  db "$db_esl" "${db_auth}.tmp"
mv "${db_auth}.tmp" "$db_auth"

# The enrolled database, read by the boot trust manager to detect a newer one.
printf '{"digest":"%s","built":%s}\n' \
  "$(sha256sum "$image_db_esl" | cut -d' ' -f1)" "$built" > "$db_enrolled"
