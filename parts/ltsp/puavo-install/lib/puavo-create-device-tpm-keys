#!/bin/sh
set -eu

tpm_version_path="/sys/class/tpm/tpm0/tpm_version_major"

if ! grep -q '2' "$tpm_version_path" 2>/dev/null; then
  echo "TPM 2.0 is not available, skipping TPM key creation" >&2
  exit 0
fi

output_directory="${1:-/images/boot/addons}"
tpm_lockout_auth_file="${output_directory}/tpm.lockout.auth"
new_lockout_auth_file="${tpm_lockout_auth_file}.new"

mkdir -p "$output_directory"

# Keep the old auth until the TPM has taken the new one, so a failure leaves
# the directory matching the TPM.
trap 'rm -f "$new_lockout_auth_file"' EXIT

# Generate random lockout auth
umask 077 && dd if=/dev/urandom of="$new_lockout_auth_file" bs=32 count=1 2>/dev/null

# Set lockout hierarchy authorization
tpm2 changeauth --object-context=lockout "file:${new_lockout_auth_file}"
mv "$new_lockout_auth_file" "$tpm_lockout_auth_file"

# Configure dictionary attack lockout parameters
tpm2 dictionarylockout \
  --setup-parameters \
  --max-tries=32 \
  --recovery-time=60 \
  --lockout-recovery-time=300 \
  --auth="file:${tpm_lockout_auth_file}"
