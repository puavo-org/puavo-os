class LuksEnrollmentPolicy
  # The format of these arguments follow the systemd-cryptenroll specifications.
  # See "man systemd-cryptenroll" or "https://www.freedesktop.org/software/systemd/man/latest/systemd-cryptenroll.html".
  attr_accessor :specific_pcrs, :public_key_pcrs, :public_key_path

  def initialize(specific_pcrs, public_key_pcrs, public_key_path)
    @specific_pcrs = specific_pcrs
    @public_key_pcrs = public_key_pcrs
    @public_key_path = public_key_path
  end

  def arguments()
    specific_pcrs_option_value = @specific_pcrs.join("+")
    public_key_pcrs_option_value = @public_key_pcrs.join("+")

    [
      "--tpm2-device=auto",
      "--tpm2-pcrs=#{ specific_pcrs_option_value }",
      "--tpm2-public-key-pcrs=#{ public_key_pcrs_option_value }",
      "--tpm2-public-key=#{ public_key_path }"
    ]
  end
end

class LuksPartitionHandler
  attr_accessor :partition, :encryption_device_name, :policy

  def initialize(partition, encryption_device_name, policy)
    @partition = partition
    @encryption_device_name = encryption_device_name
    @policy = policy
  end

  def encryption_device()
    "/dev/mapper/#{ @encryption_device_name }"
  end

  def generate_recovery_key()
    SecureRandom.gen_random(64)
  end

  def enroll_with_recovery_key(recovery_key)
    command = [ 'systemd-cryptenroll' ]
    command += @policy.arguments
    command += [ "--key-key=#{ recovery_key }", "/dev/#{ @partition }" ]

    run(*command)
  end

  def enroll_with_passphrase(passphrase)
    command = [ 'systemd-cryptenroll' ]
    command += @policy.arguments
    command += [ "/dev/#{ @partition }" ]

    system({ "PASSWORD" => passphrase }, command.join(' ')) or
      raise 'Failed to enroll LUKS encryption device'
  end

  def setup_with_recovery_key(unlock_with_tpm)
    recovery_key_file = Tempfile.new('recovery-key', '/dev/shm')
    recovery_key_file.binmode

    begin
      recovery_key = self.generate_recovery_key()
      recovery_key_file.write(recovery_key)
      recovery_key_file.flush

      puts 'Creating LUKS partition with recovery key...'
      run('cryptsetup', 'luksFormat', '--batch-mode',
        "--key-file=#{ recovery_key_file.path }", "/dev/#{ @partition }")

      puts 'Opening the LUKS partition for installing the system...'
      run('cryptsetup', 'luksOpen', "/dev/#{ @partition }",
        @encryption_device_name, "--key-file=#{ recovery_key_file.path }")

      if unlock_with_tpm then
        puts 'Enrolling the LUKS partition for TPM-based unlocking...'
        self.enroll_with_recovery_key(recovery_key)
      end

      recovery_key
    ensure
      recovery_key_file.close
      recovery_key_file.unlink
    end
  end

  def setup_with_passphrase(passphrase, unlock_with_tpm)
    if passphrase.nil? || passphrase.empty? then
      raise 'Encryption passphrase must be set'
    end

    puts 'Creating a passphrase encrypted LUKS partition...'
    IO.popen([ 'cryptsetup', 'luksFormat', '--batch-mode',
               "--key-file=-", "/dev/#{ @partition }" ], 'w') do |f|
      f.print(passphrase)
    end

    exit_status = $?
    unless exit_status.success?
      raise 'Failed to format LUKS encryption device'
    end

    puts 'Opening the LUKS partition for installing the system...'
    IO.popen([ 'cryptsetup', 'luksOpen',
               "/dev/#{ @partition }", @encryption_device_name ], 'w') do |f|
      f.print(passphrase)
    end

    exit_status = $?
    unless exit_status.success?
      raise 'Failed to open the created LUKS encryption device'
    end

    if unlock_with_tpm then
      puts 'Enrolling the LUKS partition for TPM-based unlocking...'
      self.enroll_with_passphrase(passphrase)
    end
  end
end

