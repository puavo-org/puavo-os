def run(*cmd)
  system(*cmd) or raise "Error running command: '#{ cmd.inspect }'"
end

def tpm2_available?
  system(
    'grep', '-q', '2',
    '/sys/class/tpm/tpm0/tpm_version_major'
  )
end

