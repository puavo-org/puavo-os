#!/bin/sh
set -eu

if ! ls /boot/*.uki.efi >/dev/null 2>&1; then
  exit 0
fi

# Todo: Duplicated from puavo-install-grub
mount_efi_partition() {
  local efi_devpath
  efi_devpath=$1

  mountpoint -q /boot/efi && return 0

  fsck.fat -a "$efi_devpath" > /dev/null 2>&1 || true
  mount "$efi_devpath" /boot/efi || return 1
}

get_efi_devpath() {
  local diskdev
  diskdev=$1
  # c12a7328-f81f-11d2-ba4b-00a0c93ec93b == EFI partition type
  lsblk -n -l -o PATH,PARTTYPE "$diskdev" \
    | awk '
        $2 == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; exit(0) }
      '
}

boot_disks=$(/usr/lib/puavo-ltsp-install/puavo-get-boot-disks)

for boot_disk in $boot_disks; do
  echo "Installing UKIs to boot disk: $boot_disk"
  efi_devpath=$(get_efi_devpath "$boot_disk")

  if [ -z "$efi_devpath" ]; then
    log err "Failed to find EFI partition path for boot disk"
    continue
  fi

  if ! mount_efi_partition "$efi_devpath"; then
    log err "Failed to mount EFI partition"
    continue
  fi

  if ! cp /boot/*.uki.efi /boot/efi/EFI/debian/; then
    log err "Failed to copy UKIs to EFI partition"
  fi

  umount /boot/efi || true
done
