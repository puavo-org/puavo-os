#!/bin/sh
set -eu

hosttype=$1

if [ -z "$hosttype" ]; then
  echo "Usage: $0 <hosttype>"
  exit 1
fi

if ! ls /boot/*.uki.efi >/dev/null 2>&1; then
  exit 0
fi

# Todo: Duplicated from puavo-install-grub
mount_efi_partition() {
  local efi_devpath
  efi_devpath=$1

  mountpoint -q /boot/efi && return 0

  fsck.fat -a "$efi_devpath" > /dev/null 2>&1 || true
  mount "$efi_devpath" /boot/efi || return 1
}

get_efi_devpath() {
  local diskdev
  diskdev=$1
  # c12a7328-f81f-11d2-ba4b-00a0c93ec93b == EFI partition type
  lsblk -n -l -o PATH,PARTTYPE "$diskdev" \
    | awk '
        $2 == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; exit(0) }
      '
}

install_boot_entry_config() {
  local extra_directory="$1"
  local environment_file="${extra_directory}/grubenv"

  if [ ! -r /etc/puavo-image/class ] || [ ! -r /etc/puavo-image/release ]; then
    echo "Missing boot entry information" >&2
    return 1
  fi

  local class release label
  class=$(cat /etc/puavo-image/class)
  release=$(cat /etc/puavo-image/release)
  label="PuavoOS (${release})" # Todo: Decide how we generate the labels

  [ -f "$environment_file" ] || grub-editenv "$environment_file" create || {
    echo "Failed to create the GRUB environment of a boot entry" >&2
    return 1
  }

  (grub-editenv "$environment_file" set "label=${label}" &&
    grub-editenv "$environment_file" set "class=${class}") || {
    echo "Failed to write the GRUB environment of a boot entry" >&2
    return 1
  }
}

install_uki() {
  local uki="$1"
  local destination="$2"
  local name
  name=$(basename "$uki")

  if ! cp "$uki" "$destination"; then
    echo "Failed to copy UKI to EFI partition" >&2
    return 1
  fi

  local extra_directory="${destination}/${name}.extra.d"
  if ! mkdir -p "$extra_directory"; then
    echo "Failed to create the extra directory for UKI in EFI partition" >&2
    return 1
  fi

  # Install the host type specific command line
  cp "/boot/addons/${hosttype}.addon.efi" "$extra_directory" || true

  install_boot_entry_config "$extra_directory"
}

boot_disks=$(/usr/lib/puavo-ltsp-install/puavo-get-boot-disks)

for boot_disk in $boot_disks; do
  echo "Installing UKIs to boot disk: $boot_disk"
  efi_devpath=$(get_efi_devpath "$boot_disk")

  if [ -z "$efi_devpath" ]; then
    echo "Failed to find EFI partition path for boot disk" >&2
    continue
  fi

  if ! mount_efi_partition "$efi_devpath"; then
    echo "Failed to mount EFI partition" >&2
    continue
  fi

  for uki in /boot/*.uki.efi; do
    destination="/boot/efi/EFI/debian"
    install_uki "$uki" "$destination"
  done

  if ! cp /boot/*.uki.efi /boot/efi/EFI/debian/; then
    echo "Failed to copy UKIs to EFI partition" >&2
  fi

  umount /boot/efi || true
done
