#!/bin/sh
set -eu

find_default_image() {
  local images_dir="$1"
  local default_image_tag default_image_name

  default_image_tag=$(find "$images_dir" -type f -name '*.default' | head -n 1)

  if [ -z "$default_image_tag" ]; then
    return 1
  fi

  default_image_name=$(basename "$default_image_tag" .default)
  echo "${images_dir}/${default_image_name}.img"
}

puavo-install-grub "$@"

hosttype=$(cat /etc/puavo/hosttype 2>/dev/null || true)
images_dir=/images
image_path=""

while [ $# -gt 0 ]; do
  case "$1" in
    --hosttype)
      hosttype="$2"; shift 2 ;;
    --images-dir)
      images_dir="$2"; shift 2 ;;
    --image)
      image_path="$2"; shift 2 ;;
    *)
      shift ;;
  esac
done

if [ -z "${UKI_MODE:-}" ]; then
  PUAVO_INSTALL_LIBDIR="/usr/lib/puavo-ltsp-install"
  export UKI_MODE=$("$PUAVO_INSTALL_LIBDIR"/is-uki-install "$images_dir")
fi

[ "$UKI_MODE" = "1" ] || exit 0

if [ -z "$image_path" ]; then
  image_path=$(find_default_image "$images_dir")

  if [ -z "$image_path" ]; then
    echo "Failed to find the default image in ${images_dir}" >&2
    exit 1
  fi
fi

if [ ! -f "$image_path" ]; then
  echo "Image '$image_path' does not exist" >&2
  exit 1
fi

# Update the UKI files on boot devices
puavo-install-and-update-uki-image "$image_path" "$hosttype" "$images_dir"