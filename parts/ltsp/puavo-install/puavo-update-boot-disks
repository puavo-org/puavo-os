#!/bin/sh
set -eu

if [ -z "${UKI_MODE:-}" ]; then
  export UKI_MODE=$(/usr/lib/puavo-ltsp-install/is-uki-boot && echo 1 || echo 0)
fi

puavo-install-grub "$@"

if [ "$UKI_MODE" = 0 ]; then
  exit 0
fi

hosttype=$(cat /etc/puavo/hosttype 2>/dev/null || true)
images_dir=/images

while [ $# -gt 0 ]; do
  case "$1" in
    --hosttype)
      hosttype="$2"; shift 2 ;;
    --images-dir)
      images_dir="$2"; shift 2 ;;
    *)
      shift ;;
  esac
done

# Update the UKI files on boot devices
current_image_name=$(cat /etc/puavo-image/name)
current_image="${images_dir}/${current_image_name}"
puavo-install-and-update-uki-image "$current_image" "$hosttype" "$images_dir"