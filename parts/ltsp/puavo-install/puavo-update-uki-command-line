#!/bin/sh
set -eu

usage() {
  echo "Usage: $0 <image-mountpoint> <images-dir> <uki-root> <host-type>" >&2
  exit 1
}

[ $# -eq 4 ] || usage

image_mountpoint="$1"
images_dir="$2"
addons_dir="${images_dir}/boot/addons"
uki_root="$3"
hosttype="$4"

boot_directory="${image_mountpoint}/boot"

if [ ! -d "$boot_directory" ]; then
  echo "error: boot directory '$boot_directory' does not exist" >&2
  exit 1
fi

if [ ! -d "$uki_root" ]; then
  echo "error: UKI root '$uki_root' does not exist" >&2
  exit 1
fi

install_command_line() {
  local uki="$1"
  local destination="$2"
  local image_name_no_suffix="$3"

  local uki_name
  uki_name=$(basename "$uki")

  local extra_directory="${destination}/${image_name_no_suffix}/${uki_name}.extra.d"
  if ! mkdir -p "$extra_directory"; then
    echo "error: failed to create the extra directory for UKI in EFI partition" >&2
    return 1
  fi

  # Install the host type specific command line
  cp "${boot_directory}/addons/${hosttype}.addon.efi" \
     "${extra_directory}/cmdline.addon.efi"

  # Install device-specific addons
  if [ -d "${addons_dir}" ]; then
    find "${addons_dir}" -maxdepth 1 -name "*.addon.efi" -type f \
      -exec cp {} "${extra_directory}/" \;
  fi
}

if ! image_name="$(cat "${image_mountpoint}/etc/puavo-image/name")" \
  || [ -z "$image_name" ]; then
    echo 'could not determine image name' >&2
    exit 1
fi
image_name_no_suffix=${image_name%.img}

for uki in "$boot_directory"/*.uki.efi; do
  install_command_line "$uki" "$uki_root" "$image_name_no_suffix" || {
    echo "error: failed to install command line for UKI '$uki'" >&2
    exit 1
  }
done
