#!/bin/sh

set -eu

log() {
  local message priority
  priority=$1
  message=$2
  logger -p "$priority" -t puavo-autoreboot "$message" || true
}

if [ "$(puavo-conf puavo.admin.autoreboot.enabled)" != 'true' ]; then
  exit 0
fi

log notice 'automatic reboot enabled, rebooting'

exec /usr/sbin/reboot
