#!/bin/sh

set -eu

puavo_topdomain=$(cat /etc/puavo/topdomain 2>/dev/null || true)

if [ -z "${puavo_topdomain:-}" ]; then
  echo 'could not determine puavo topdomain' >&2
  exit 1
fi

ntp_server="ntp.${puavo_topdomain}"

# XXX when about the case where this should listen?
cat <<EOF > /etc/openntpd/ntpd.conf.tmp
server ${ntp_server}
EOF

mv /etc/openntpd/ntpd.conf.tmp /etc/openntpd/ntpd.conf
