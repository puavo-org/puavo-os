#!/bin/sh

set -eu

for x in $(cat /proc/cmdline); do
  case "$x" in
    puavo.hosttype=*)
      puavo_hosttype="${x#puavo.hosttype=}"
      break
      ;;
  esac
done

if [ -z "$puavo_hosttype" ]; then
  echo 'puavo hosttype not set, that is bad' >&2
  exit 1
fi

mkdir -p /etc/puavo
printf "%s\n" "$puavo_hosttype" > /etc/puavo/hosttype
