#!/bin/bash
set -eu

usage() {
  echo "Usage: $0 <output-directory>" >&2
  exit 1
}

if [[ $# -ne 1 ]]; then
  usage
fi

output_directory=$1

script_directory=$(dirname "$0")
configurators_directory="${script_directory}/../configurators/"

cp -r "${configurators_directory}/primary/." "$output_directory"
