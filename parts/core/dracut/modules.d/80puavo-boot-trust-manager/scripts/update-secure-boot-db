#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
  echo "Usage: $0 <boot-vault-mountpoint> <efi-signature-list> <date>" >&2
  exit 1
fi

boot_vault_mountpoint=$1
efi_signature_list=$2
signed_at=$3

kek_private_key="${boot_vault_mountpoint}/kek.priv"

for file in "$kek_private_key" "$efi_signature_list"; do
  if [ ! -f "$file" ]; then
    echo "error: required file not found: ${file}" >&2
    exit 2
  fi
done

# Remove the immutable attribute from efivarfs entries for db.
for entry in /sys/firmware/efi/efivars/db-*; do
  if [ -e "$entry" ]; then
    chattr -i "$entry" 2>/dev/null || true
  fi
done

kek_certificate="${boot_vault_mountpoint}/kek.pem"

signed_update=$(mktemp /tmp/db.auth.XXXXXX)
trap 'rm -f "$signed_update"' EXIT

# The firmware rejects an update whose timestamp is not later than the stored
# one. The build date of the database is the same on every device, unlike the
# clock.
sign-efi-sig-list -t "$signed_at" \
  -k "$kek_private_key" -c "$kek_certificate" \
  db "$efi_signature_list" "$signed_update"

# Replace db with the whole list, so the variable holds exactly the signed
# bytes.
efi-updatevar -f "$signed_update" db
