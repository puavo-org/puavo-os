#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
  echo "Usage: $0 <boot-vault-mountpoint> <revocation-list> <date>" >&2
  exit 1
fi

boot_vault_mountpoint=$1
revocation_list=$2
signed_at=$3

kek_private_key="${boot_vault_mountpoint}/kek.priv"

for file in "$kek_private_key" "$revocation_list"; do
  if [ ! -f "$file" ]; then
    echo "error: required file not found: ${file}" >&2
    exit 2
  fi
done

# Remove the immutable attribute from efivarfs entries for dbx.
for entry in /sys/firmware/efi/efivars/dbx-*; do
  if [ -e "$entry" ]; then
    chattr -i "$entry" 2>/dev/null || true
  fi
done

kek_certificate="${boot_vault_mountpoint}/kek.pem"

signed_update=$(mktemp /tmp/dbx.auth.XXXXXX)
trap 'rm -f "$signed_update"' EXIT

sign-efi-sig-list -t "$signed_at" \
  -k "$kek_private_key" -c "$kek_certificate" \
  dbx "$revocation_list" "$signed_update"

# Replace dbx with the whole list.
efi-updatevar -f "$signed_update" dbx
