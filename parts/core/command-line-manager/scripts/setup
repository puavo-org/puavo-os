#!/bin/sh
#
# Fetches and patches sbsigntools for use as a build
# dependency. The result is cached in the target
# directory and only fetched once.
#
# Usage:
#   setup-sbsigntools <target-directory> <patches-directory>

set -eu

if [ $# -ne 2 ]; then
  echo "Usage: $0 <target-directory> <patches-directory>" >&2
  exit 1
fi

target_directory=$1
patches_directory=$2

SBSIGNTOOLS_ARCHIVE_URL="http://deb.debian.org/debian/pool/main/s/sbsigntool/sbsigntool_0.9.5.orig.tar.gz"
SBSIGNTOOLS_ARCHIVE_SHA256="fa93920ef80a406115c1de6f7764ffa4c34e3d1bd7890b9145c36de899a258f5"

# Skip if already fetched
if [ -f "${target_directory}/.fetched" ]; then
  exit 0
fi

echo "Fetching ${SBSIGNTOOLS_ARCHIVE_URL}..."

archive=$(mktemp)
trap 'rm -f "${archive}"' EXIT

wget --quiet --output-document="${archive}" "${SBSIGNTOOLS_ARCHIVE_URL}"

echo "${SBSIGNTOOLS_ARCHIVE_SHA256}  ${archive}" | sha256sum --check --quiet

mkdir -p "${target_directory}"
tar --extract --gzip --strip-components=1 \
  --file="${archive}" --directory="${target_directory}"

# Apply patches
echo "Applying patches..."

for patch_file in "${patches_directory}"/*.patch; do
  if [ -f "${patch_file}" ]; then
    echo "  Applying $(basename "${patch_file}")..."
    patch -d "${target_directory}" -p1 < "${patch_file}"
  fi
done

touch "${target_directory}/.fetched"
echo "sbsigntools setup complete."
