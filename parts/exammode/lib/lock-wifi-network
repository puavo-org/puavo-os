#!/bin/sh

set -eu
set -x

# XXX should implement --unlock as well

mode=${1:-}

if ! { [ "$mode" = '' ] || [ "$mode" = '--unlock' ]; }; then
  echo "unsupported mode '${mode}'" >&2
  exit 1
fi

if ! mountpoint -q /state; then
  echo '/state is not mounted, is this a laptop?' >&2
  exit 1
fi

currently_active_wifi_network=$(
  env LANG=C nmcli -t -f NAME,TYPE connection show --active \
    | awk -F: '$2 == "802-11-wireless" { print $1; exit(0) }')

if [ -z "$currently_active_wifi_network" ]; then
  echo 'no currently active wifi network' >&2
  exit 1
fi

# XXX path may not be that one... should lookup by id?
nm_statedir='/state/etc/NetworkManager/system-connections'
nmconnection_path="${nm_statedir}/${currently_active_wifi_network}.nmconnection"
if ! [ -e "$nmconnection_path" ]; then
  echo 'could not find nm connection file' >&2
  exit 1
fi

rm -rf /etc/NetworkManager/system-connections.exammode
mkdir -p /etc/NetworkManager/system-connections.exammode
cp -p "$nmconnection_path" /etc/NetworkManager/system-connections.exammode
ln -fns /etc/NetworkManager/system-connections.exammode \
        /etc/NetworkManager/system-connections

nmcli connection reload
