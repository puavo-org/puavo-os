{
  "name": "puavo-exam-browser",
  "version": "1.0.0",
  "description": "Puavo Exam Browser",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack",
    "start": "npm run build && electron dist/main.js",
    "dev": "webpack --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "check-all": "npm run type-check && npm run lint && npm run format:check",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "org.puavo.puavo-exam-browser",
    "productName": "puavo-exam-browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["dir"],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "ajv": "^8.17.1",
    "css-loader": "^7.1.2",
    "electron": "^37.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "minimatch": "^10.0.3",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  }
}
