#!/bin/sh

set -eu

get_image() {
  local filename url
  url=$1
  filename=${url##*/}
  test -e "$filename" && return 0
  if ! wget -O "${filename}.tmp" "$url"; then
    echo "failed to fetch ${url}" >&2
    return 1
  fi
  if ! mv "${filename}.tmp" "$filename"; then
    echo "failed to move ${filename}" >&2
    return 1
  fi
  return 0
}

resize_image() {
  local filename target_size url
  url=$1
  target_size=$2

  origin_filename=${url##*/}
  target_filename="${origin_filename%.qcow2}-${target_size}.qcow2"

  test -e "$target_filename" && return 0

  if ! cp -p "$origin_filename" "${target_filename}.tmp"; then
    echo "failed to copy to ${target_filename}.tmp" >&2
    return 1
  fi
  if ! qemu-img resize "${target_filename}.tmp" "$target_size"; then
    echo "failed to resize ${target_filename}.tmp" >&2
    return 1
  fi
  if ! mv "${target_filename}.tmp" "$target_filename"; then
    echo "failed to move ${target_filename}" >&2
    return 1
  fi
  return 0
}

debian_cloud_image_urls='
  https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2
  https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
'

cd /var/lib/openqa/share/factory/hdd
for url in $debian_cloud_image_urls; do
  get_image "$url"
  resize_image "$url" 20G
done

# XXX should these be in public archives?
# XXX the versions should probably be gotten from the catalogue-files
read puavo_topdomain < /etc/puavo/topdomain
cdn_server="cdn.${puavo_topdomain}"

puavo_image_urls="
  https://${cdn_server}/install/install-opinsys-os-opinsys-stretch-2021-12-17-100211-amd64.img
  https://${cdn_server}/install/install-opinsys-os-opinsys-buster-2023-08-17-115006-amd64.img
  https://${cdn_server}/install/install-opinsys-os-opinsys-bullseye-2025-09-12-092002-amd64.img
  https://${cdn_server}/install/install-opinsys-os-opinsys-bookworm-2025-09-12-092034-amd64.img
"

cd /var/lib/openqa/share/factory/iso
for url in $puavo_image_urls; do
  get_image "$url"
done
