#!/bin/bash

POLL_INTERVAL=${POLL_INTERVAL:-30}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET_COLOR='\033[0m'

log() {
  echo -e "[$(date '+%Y-%m-%d %H:%M:%S')]: $1"
}

log_error() {
  log "${RED}error: $1${RESET_COLOR}"
}

log_success() {
  log "${GREEN}success: $1${RESET_COLOR}"
}

log_warning() {
  log "${YELLOW}warning: $1${RESET_COLOR}"
}

wait_for_job() {
  local job_id=$1
  
  log "waiting for job ${job_id} to complete..."
    
  while true; do
    local job_info
    job_info=$(openqa-cli api "jobs/${job_id}" 2>/dev/null || echo "")

    if [ -z "$job_info" ]; then
      log_error "failed to get job info for job ${job_id}"
      return 1
    fi

    # Extract state from JSON response
    local state
    state=$(echo "$job_info" | jq --raw-output ".job.state")

    case "$state" in
      "done")
        local result
        result=$(echo "$job_info" | jq --raw-output ".job.result")
        log "job $job_id completed with result: ${result}"

        if [ "$result" = "passed" ]; then
          return 0
        else
          log_error "job ${job_id} failed with result: ${result}"
          return 1
        fi
        ;;
      "cancelled"|"obsoleted")
        log "job ${job_id} was ${state}"
        return 1
        ;;
      *)
        log "job ${job_id} is ${state}, continuing to wait..."
        sleep $POLL_INTERVAL
        ;;
    esac
  done
}

submit_job() {
  local build iso_directory iso_name iso_name_no_suffix iso_path job_id \
        job_name machine_ovmf_vars_path machine_state_dir ovmf_vars_file \
        response reset schedule

  job_name=$1
  schedule=$2
  reset=$3
  shift 3 # Remove first three parameters, rest are custom test module options

  log "submitting ${job_name} job..."

  # Decide the ISO file used for testing
  iso_directory='/var/lib/openqa/share/factory/iso'
  if [ -n "${ISO:-}" ]; then
    iso_path="$ISO"
  else
    # pick the ISO that sorts last (which is likely the latest)
    iso_path=$(ls "$iso_directory"/*.img 2>/dev/null | sort | tail -n 1) || true
  fi

  if [ -z "$iso_path" ]; then
    log_error "failed to find ISO file in ${iso_directory}"
    return 1
  fi

  iso_name=$(basename "$iso_path")

  # Attempt to extract the build version:
  # puavo-os-2025-05-05-123456-amd64.img => 2025-05-05-123456
  if [[ "$iso_name" =~ ([0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}) ]]; then
    build="${BASH_REMATCH[1]}"
  else
    build="$iso_name"
  fi

  machine_state_dir='/var/lib/openqa/share/data'
  iso_name_no_suffix=${iso_name%.img}
  ovmf_vars_file="OVMF_VARS_4M-${iso_name_no_suffix#install-}.ms.fd"
  machine_ovmf_vars_path="${machine_state_dir}/${ovmf_vars_file}"
  if $reset; then
    # XXX this should not require root
    # XXX the equivalent code should be run by the _openqa-worker user?
    # XXX it should be possible to do tie this to a machine identity,
    # XXX but where should that be determined?
    mkdir -p "$machine_state_dir"
    chown _openqa-worker:root "$machine_state_dir"
    install -o _openqa-worker -g root -m 644 \
            /usr/share/OVMF/OVMF_VARS_4M.ms.fd "$machine_ovmf_vars_path"
  fi

  if [ ! -e "$machine_ovmf_vars_path" ]; then
    log_error "${machine_ovmf_vars_path} does not exist"
    return 1
  fi

  qemu_append="machine q35 -bios /usr/share/OVMF/OVMF_CODE_4M.ms.fd -global driver=cfi.pflash01,property=secure,value=off -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.ms.fd -drive if=pflash,format=raw,file=${machine_ovmf_vars_path} -boot menu=on -enable-kvm"
  if ! response=$(openqa-cli api -X POST isos  \
                    ARCH=x86_64                \
                    BUILD="$build"             \
                    DISTRI=puavo               \
                    FLAVOR=iso                 \
                    ISO="$iso_name"            \
                    QEMU_APPEND="$qemu_append" \
                    QEMUTPM=1                  \
                    SCHEDULE="$schedule"       \
                    VERSION=generic            \
                    "$@"); then
    log_error "failed to submit job: ${response}"
    return 1
  fi

  # Extract job ID from response
  job_id=$(echo "$response" | jq --raw-output '.ids[0]')

  if [ -z "$job_id" ] || [ "$job_id" = "null" ]; then
    log_error "failed to extract job id from response: $response"
    return 1
  fi
  
  log "job submitted successfully with id: $job_id"

  if ! wait_for_job "$job_id"; then
    log_error "${job_name} job failed after attempts"
    return 1
  fi

  log_success "${job_name} job completed successfully"

  return 0
}
